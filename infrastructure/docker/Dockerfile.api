# -----------------------------------------------------------------------------
# Production Dockerfile for AI Companion API Service
# Multi-stage, non-root user, minimal runtime attack surface
# -----------------------------------------------------------------------------

FROM node:24-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@11.7.0 --activate

# Stage 1: Dependencies & Builder
FROM base AS builder
WORKDIR /app

# Copy configuration and package manifests
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json tsconfig.json ./
COPY packages/ ./packages/
COPY apps/api/ ./apps/api/

# Install frozen dependencies
RUN pnpm install --frozen-lockfile

# Generate Prisma Client
RUN pnpm --filter @ai-companion/api run db:generate

# Build workspace packages and API
RUN pnpm --filter @ai-companion/types build && \
    pnpm --filter @ai-companion/validation build && \
    pnpm --filter @ai-companion/config build && \
    pnpm --filter @ai-companion/utils build && \
    pnpm --filter @ai-companion/api-client build && \
    pnpm --filter @ai-companion/api build

# Stage 2: Production Runner
FROM node:24-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=4000

# Install dumb-init for clean Linux signal handling (SIGTERM/SIGINT)
RUN apk add --no-cache dumb-init

# Create dedicated unprivileged non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

COPY --from=builder --chown=nodejs:nodejs /app/package.json ./
COPY --from=builder --chown=nodejs:nodejs /app/pnpm-lock.yaml ./
COPY --from=builder --chown=nodejs:nodejs /app/pnpm-workspace.yaml ./
COPY --from=builder --chown=nodejs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nodejs:nodejs /app/packages ./packages
COPY --from=builder --chown=nodejs:nodejs /app/apps/api/dist ./apps/api/dist
COPY --from=builder --chown=nodejs:nodejs /app/apps/api/package.json ./apps/api/package.json
COPY --from=builder --chown=nodejs:nodejs /app/apps/api/prisma ./apps/api/prisma

USER nodejs

EXPOSE 4000

# Health check using native Node.js HTTP probe
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "require('http').get('http://localhost:4000/health/live', (r) => { process.exit(r.statusCode === 200 ? 0 : 1); })"

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["node", "apps/api/dist/server.js"]
