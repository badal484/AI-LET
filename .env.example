# ==============================================================================
# AI COMPANION PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env or .env.local for local development. Never commit real secrets.
# ==============================================================================

# --- Server & Runtime ---
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:8081,exp://*
LOG_LEVEL=debug

# --- Database (PostgreSQL 16 with pgvector) ---
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/ai_companion_dev?schema=public

# --- Redis (Cache, Rate Limiting, BullMQ) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Authentication & Security ---
JWT_ACCESS_SECRET=super_secret_jwt_access_token_key_change_in_production_min_32_chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=super_secret_jwt_refresh_token_key_change_in_production_min_32_chars
JWT_REFRESH_EXPIRATION=30d
BCRYPT_SALT_ROUNDS=12

# --- AI Provider API Keys ---
OPENAI_API_KEY=sk-mock-openai-key-replace-in-production
ANTHROPIC_API_KEY=sk-ant-mock-key-replace-in-production
GOOGLE_AI_API_KEY=mock-google-key-replace-in-production

# --- AI Model Routing & Defaults ---
DEFAULT_CHAT_MODEL=gpt-4o-mini
DEFAULT_FALLBACK_CHAT_MODEL=gemini-1.5-flash
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
DEFAULT_EXTRACTION_MODEL=gpt-4o-mini

# --- Voice & Audio (TTS / STT) ---
ELEVENLABS_API_KEY=mock-elevenlabs-key

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AI_RATE_LIMIT_MAX_REQUESTS_PER_MINUTE=20

# --- Feature Flags ---
ENABLE_MEMORY_EXTRACTION=true
ENABLE_PROACTIVE_MESSAGING=false
ENABLE_VOICE_CALLS=false
ENABLE_IMAGE_GENERATION=false
SOCIAL_PUBLIC_BASE_URL=https://aicompanion.app
