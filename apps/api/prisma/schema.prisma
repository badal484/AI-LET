datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
  DELETED
}

enum CharacterStatus {
  DRAFT
  REVIEW
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

enum CharacterVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum CharacterVersionStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
  ROLLED_BACK
}

enum CreatorStatus {
  PENDING
  ACTIVE
  RESTRICTED
  SUSPENDED
  BANNED
  CLOSED
}

enum CreatorVerificationStatus {
  UNVERIFIED
  VERIFIED
  PARTNER
}

enum CharacterSourceType {
  OFFICIAL
  CREATOR
  PARTNER
}

enum CharacterModerationStatus {
  DRAFT
  PENDING
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  SUSPENDED
}

enum ModerationDecisionType {
  APPROVE
  REJECT
  REQUEST_CHANGES
  SUSPEND
  UNPUBLISH
}

enum ReportReasonCode {
  UNSAFE
  HARASSMENT
  IMPERSONATION
  COPYRIGHT
  SEXUAL_CONTENT
  MISLEADING
  SPAM
  OTHER
}

enum RejectionReasonCode {
  PROHIBITED_CONTENT
  IMPERSONATION
  COPYRIGHT_CONCERN
  SAFETY_CONFIGURATION
  MISLEADING_DESCRIPTION
  SEXUAL_CONTENT_POLICY
  MINOR_SAFETY
  HARASSMENT
  SPAM
  OTHER
}

enum SafetySurface {
  INPUT
  OUTPUT
  CREATOR_CONTENT
  KNOWLEDGE
  MEDIA
  VOICE
  PROACTIVE
  STREAM
}

enum SafetyDecision {
  ALLOW
  ALLOW_WITH_TRANSFORM
  BLOCK
  REVIEW
  ESCALATE
}

enum SafetyRiskLevel {
  NONE
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AccountRestrictionType {
  CANNOT_CREATE_CHARACTER
  CANNOT_PUBLISH
  CANNOT_UPLOAD_MEDIA
  CANNOT_USE_VOICE
  CANNOT_SEND_MESSAGES
  CANNOT_PURCHASE
  SOCIAL_RESTRICTED
  CANNOT_COMMENT
  CANNOT_DIRECT_MESSAGE
  CANNOT_SHARE_CONTENT
  CANNOT_CREATE_COMMUNITIES
  ACCOUNT_RESTRICTED
  ACCOUNT_SUSPENDED
  ACCOUNT_BANNED
}

enum DataExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
}

enum AccountDeletionStatus {
  PENDING
  PROCESSING
  CONFIRMED
  COMPLETED
  CANCELLED
  FAILED
}

enum IncidentSeverity {
  SEV1
  SEV2
  SEV3
  SEV4
}

enum IncidentCategory {
  SAFETY
  PRIVACY
  SECURITY
  BILLING
  AVAILABILITY
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  MITIGATED
  RESOLVED
  CLOSED
}

enum KillSwitchType {
  DISABLE_CHARACTER_PUBLISHING
  DISABLE_IMAGE_GENERATION
  DISABLE_VOICE_CALLS
  DISABLE_PROACTIVE_NOTIFICATIONS
  DISABLE_MODEL_PROVIDER
  DISABLE_CHARACTER
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
  BLOCKED
}

enum MessageSenderType {
  USER
  CHARACTER
  SYSTEM
}

enum MessageStatus {
  PENDING
  STREAMING
  SENT
  COMPLETED
  FAILED
  CANCELLED
  INTERRUPTED
}

enum MemoryType {
  EPISODIC
  SEMANTIC_FACT
  PREFERENCE
  RELATIONSHIP_MILESTONE
}

enum MemoryScope {
  GLOBAL_USER
  CHARACTER_SPECIFIC
}

enum MemoryStatus {
  CANDIDATE
  ACTIVE
  SUPERSEDED
  EXPIRED
  DELETED
  REJECTED
}

enum MemoryCategory {
  PREFERENCE
  INTEREST
  GOAL
  HABIT
  PERSONAL_FACT
  IMPORTANT_EVENT
  RELATIONSHIP
  COMMUNICATION_PREFERENCE
  TEMPORARY_CONTEXT
  OTHER
}

enum MemorySensitivity {
  NORMAL
  SENSITIVE
  HIGHLY_SENSITIVE
}

enum MemorySignalType {
  EXPLICIT
  IMPLICIT
  INFERRED
  SYSTEM_GENERATED
}

enum RelationshipStage {
  STRANGER
  ACQUAINTANCE
  FRIEND
  CLOSE_FRIEND
  CONFIDANT
  ROMANTIC_PARTNER
}

// -----------------------------------------------------------------------------
// 1. User & Identity Layer
// -----------------------------------------------------------------------------

model User {
  id                        String                      @id @default(uuid()) @db.Uuid
  email                     String                      @unique @db.VarChar(255)
  normalizedEmail           String                      @unique @map("normalized_email") @db.VarChar(255)
  phoneNumber               String?                     @map("phone_number") @db.VarChar(50)
  normalizedPhoneNumber     String?                     @map("normalized_phone_number") @db.VarChar(50)
  passwordHash              String?                     @map("password_hash") @db.VarChar(255)
  status                    UserStatus                  @default(ACTIVE)
  emailVerifiedAt           DateTime?                   @map("email_verified_at") @db.Timestamptz(6)
  phoneVerifiedAt           DateTime?                   @map("phone_verified_at") @db.Timestamptz(6)
  lastLoginAt               DateTime?                   @map("last_login_at") @db.Timestamptz(6)
  lastActiveAt              DateTime?                   @map("last_active_at") @db.Timestamptz(6)
  profile                   UserProfile?
  authIdentities            AuthIdentity[]
  sessions                  Session[]
  devices                   Device[]
  emailTokens               EmailVerificationToken[]
  passwordResetTokens       PasswordResetToken[]
  conversations             Conversation[]
  relationships             Relationship[]
  relationshipSettings      UserRelationshipSettings?
  memories                  Memory[]
  memorySettings            UserMemorySettings?
  messageFeedbacks          MessageFeedback[]
  notificationPreferences   UserNotificationPreference?
  userDevices               UserDevice[]
  proactiveActions          ProactiveAction[]
  proactiveDecisionLogs     ProactiveDecisionLog[]
  userReminders             UserReminder[]
  generationTraces          AIGenerationTrace[]
  voiceSessions             VoiceSession[]
  voicePreferences          UserVoicePreference?
  createdCharacters         Character[]                 @relation("CharacterCreator")
  characterVersions         CharacterVersion[]          @relation("VersionCreator")
  subscriptions             BillingSubscription[]
  userEntitlements          UserEntitlement[]
  usageMeters               UsageMeter[]
  usageReservations         UsageReservation[]
  creditWallet              CreditWallet?
  creditTransactions        CreditTransaction[]
  purchaseTransactions      PurchaseTransaction[]
  promoRedemptions          PromoRedemption[]
  billingReconciliations    BillingReconciliation[]
  favorites                 UserFavorite[]
  discoveryPreferences      UserDiscoveryPreference?
  characterSignals          UserCharacterSignal[]
  searchQueryLogs           SearchQueryLog[]
  discoveryEventLogs        DiscoveryEventLog[]
  firstSession              UserFirstSession?
  activationFunnelLogs      ActivationFunnelLog[]
  inAppNotifications        InAppNotification[]
  notificationDeliveryLogs  NotificationDeliveryLog[]
  creatorProfile            CreatorProfile?
  creatorFollows            CreatorFollow[]
  characterReports          CharacterReport[]           @relation("ReporterUser")
  moderationCasesReviewed   ModerationCase[]            @relation("ModeratorAdmin")
  moderationAppealsReviewed ModerationAppeal[]          @relation("AppealReviewerAdmin")
  restrictions              UserRestriction[]
  blocksInitiated           UserBlock[]                 @relation("UserBlocksInitiated")
  blockedByOthers           UserBlock[]                 @relation("BlockedUserTarget")
  privacySettings           UserPrivacySettings?
  dataExportRequests        DataExportRequest[]
  accountDeletionRequests   AccountDeletionRequest[]
  safetyEvaluationLogs      SafetyEvaluationLog[]
  incidentsLed              SafetyIncident[]            @relation("LeadAdminIncidents")
  killSwitchesActivated     EmergencyKillSwitch[]       @relation("KillSwitchAdmin")
  searchHistories           UserSearchHistory[]
  negativeSignals           UserNegativeSignal[]
  socialProfile             SocialProfile?
  socialPrivacySettings     SocialPrivacySettings?
  usernameHistory           SocialUsernameHistory[]
  followsInitiated          UserFollow[]                @relation("FollowFollower")
  followsReceived           UserFollow[]                @relation("FollowFollowed")
  characterFollows          CharacterFollow[]
  socialMutes               UserMute[]
  socialContents            SocialContent[]             @relation("SocialContentAuthor")
  socialReactions           SocialReaction[]
  socialComments            SocialComment[]             @relation("SocialCommentAuthor")
  socialReports             SocialReport[]
  socialAppeals             SocialAppeal[]
  messageRequestsSent       SocialMessageRequest[]      @relation("MessageRequestSender")
  messageRequestsReceived   SocialMessageRequest[]      @relation("MessageRequestRecipient")
  directThreads             SocialDirectParticipant[]
  directMessagesSent        SocialDirectMessage[]       @relation("DirectMessageSender")
  communitiesOwned          Community[]                 @relation("CommunityOwner")
  communityMemberships      CommunityMember[]
  socialConsents            SocialConsent[]
  socialFeedFeedback        SocialFeedFeedback[]
  scheduledSocialActions    ScheduledSocialAction[]
  deletedAt                 DateTime?                   @map("deleted_at") @db.Timestamptz(6)
  createdAt                 DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status])
  @@index([normalizedEmail])
  @@index([normalizedPhoneNumber])
  @@map("users")
}

model UserProfile {
  id                       String    @id @default(uuid()) @db.Uuid
  userId                   String    @unique @map("user_id") @db.Uuid
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName              String    @map("display_name") @db.VarChar(100)
  username                 String?   @unique @db.VarChar(50)
  avatarUrl                String?   @map("avatar_url") @db.Text
  bio                      String?   @db.VarChar(500)
  dateOfBirth              DateTime? @map("date_of_birth") @db.Date
  locale                   String    @default("en-US") @db.VarChar(10)
  timezone                 String    @default("UTC") @db.VarChar(50)
  preferredLanguage        String    @default("en") @map("preferred_language") @db.VarChar(10)
  onboardingCompleted      Boolean   @default(false) @map("onboarding_completed")
  onboardingStatus         String    @default("NOT_STARTED") @map("onboarding_status") @db.VarChar(30) // 'NOT_STARTED', 'IN_PROGRESS', 'COMPLETED', 'SKIPPED', 'NEEDS_RECOVERY'
  onboardingVersion        Int       @default(1) @map("onboarding_version")
  onboardingCurrentStep    String    @default("WELCOME") @map("onboarding_current_step") @db.VarChar(50) // 'WELCOME', 'LANGUAGE', 'INTERESTS', 'STYLE', 'CHARACTER_SELECTION', 'COMPLETED'
  onboardingCompletedSteps Json      @default("[]") @map("onboarding_completed_steps") @db.JsonB
  onboardingStartedAt      DateTime? @map("onboarding_started_at") @db.Timestamptz(6)
  onboardingCompletedAt    DateTime? @map("onboarding_completed_at") @db.Timestamptz(6)
  conversationStyle        String    @default("CASUAL") @map("conversation_style") @db.VarChar(30) // 'CASUAL', 'FUNNY', 'DEEP', 'SUPPORTIVE', 'DIRECT', 'PLAYFUL'
  isNsfwAllowed            Boolean   @default(false) @map("is_nsfw_allowed")
  audioAutoPlay            Boolean   @default(true) @map("audio_auto_play")
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("user_profiles")
}

model AuthIdentity {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        String   @db.VarChar(50) // 'email', 'google', 'apple', 'phone'
  providerSubject String   @map("provider_subject") @db.VarChar(255)
  providerEmail   String?  @map("provider_email") @db.VarChar(255)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("auth_identities")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId         String?   @map("device_id") @db.Uuid
  device           Device?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  tokenFamilyId    String    @map("token_family_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash") @db.VarChar(255)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  lastUsedAt       DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokeReason     String?   @map("revoke_reason") @db.VarChar(100)
  ipAddress        String?   @map("ip_address") @db.VarChar(45)
  userAgent        String?   @map("user_agent") @db.VarChar(500)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId, revokedAt])
  @@index([tokenFamilyId])
  @@index([refreshTokenHash])
  @@map("sessions")
}

model Device {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform   String    @db.VarChar(20) // 'ios', 'android', 'web', 'unknown'
  appVersion String?   @map("app_version") @db.VarChar(30)
  osVersion  String?   @map("os_version") @db.VarChar(30)
  deviceName String?   @map("device_name") @db.VarChar(100)
  pushToken  String?   @map("push_token") @db.VarChar(255)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  sessions   Session[]
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("devices")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("password_reset_tokens")
}

// -----------------------------------------------------------------------------
// 2. Privileged Admin Layer & RBAC
// -----------------------------------------------------------------------------

model AdminUser {
  id              String                @id @default(uuid()) @db.Uuid
  email           String                @unique @db.VarChar(255)
  normalizedEmail String                @unique @map("normalized_email") @db.VarChar(255)
  passwordHash    String                @map("password_hash") @db.VarChar(255)
  displayName     String                @map("display_name") @db.VarChar(100)
  isActive        Boolean               @default(true) @map("is_active")
  isMfaEnabled    Boolean               @default(false) @map("is_mfa_enabled")
  mfaSecret       String?               @map("mfa_secret") @db.VarChar(255)
  lastLoginAt     DateTime?             @map("last_login_at") @db.Timestamptz(6)
  roles           AdminRoleAssignment[]
  sessions        AdminSession[]
  deletedAt       DateTime?             @map("deleted_at") @db.Timestamptz(6)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive])
  @@index([normalizedEmail])
  @@map("admin_users")
}

model AdminRole {
  id          String                @id @default(uuid()) @db.Uuid
  name        String                @unique @db.VarChar(50) // 'super_admin', 'admin', etc.
  description String                @db.VarChar(255)
  permissions AdminRolePermission[]
  admins      AdminRoleAssignment[]
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("admin_roles")
}

model AdminPermission {
  id          String                @id @default(uuid()) @db.Uuid
  name        String                @unique @db.VarChar(100) // 'users.read', 'users.write', etc.
  description String                @db.VarChar(255)
  roles       AdminRolePermission[]
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("admin_permissions")
}

model AdminRoleAssignment {
  id        String    @id @default(uuid()) @db.Uuid
  adminId   String    @map("admin_id") @db.Uuid
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  roleId    String    @map("role_id") @db.Uuid
  role      AdminRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([adminId, roleId])
  @@map("admin_role_assignments")
}

model AdminRolePermission {
  id           String          @id @default(uuid()) @db.Uuid
  roleId       String          @map("role_id") @db.Uuid
  role         AdminRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String          @map("permission_id") @db.Uuid
  permission   AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([roleId, permissionId])
  @@map("admin_role_permissions")
}

model AdminSession {
  id               String    @id @default(uuid()) @db.Uuid
  adminId          String    @map("admin_id") @db.Uuid
  admin            AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  sessionTokenHash String    @unique @map("session_token_hash") @db.VarChar(255)
  ipAddress        String?   @map("ip_address") @db.VarChar(45)
  userAgent        String?   @map("user_agent") @db.VarChar(500)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([adminId, revokedAt])
  @@map("admin_sessions")
}

// -----------------------------------------------------------------------------
// 3. Security Audit Logs
// -----------------------------------------------------------------------------

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorType    String   @map("actor_type") @db.VarChar(20) // 'USER', 'ADMIN', 'SYSTEM'
  actorId      String?  @map("actor_id") @db.Uuid
  action       String   @db.VarChar(100) // e.g. 'USER_REGISTERED', 'CHARACTER_PUBLISHED'
  resourceType String   @map("resource_type") @db.VarChar(50)
  resourceId   String?  @map("resource_id") @db.VarChar(100)
  metadata     Json?
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  userAgent    String?  @map("user_agent") @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([actorType, actorId])
  @@index([resourceType, resourceId])
  @@index([action, createdAt(sort: Desc)])
  @@map("audit_logs")
}

// -----------------------------------------------------------------------------
// 4. Character Engine (Phase 3 Foundation)
// -----------------------------------------------------------------------------

model Character {
  id                        String                     @id @default(uuid()) @db.Uuid
  internalKey               String                     @unique @map("internal_key") @db.VarChar(50)
  slug                      String                     @unique @db.VarChar(100)
  name                      String                     @db.VarChar(100)
  tagline                   String                     @db.VarChar(255)
  shortDescription          String                     @default("") @map("short_description") @db.VarChar(300)
  longDescription           String                     @default("") @map("long_description") @db.Text
  avatarUrl                 String                     @map("avatar_url") @db.Text
  coverImageUrl             String                     @map("cover_image_url") @db.Text
  category                  String                     @default("general") @db.VarChar(50)
  categoryId                String?                    @map("category_id") @db.Uuid
  categoryRef               CharacterCategory?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  archetype                 String                     @db.VarChar(50)
  backstory                 String                     @db.Text
  age                       Int                        @db.SmallInt
  gender                    String                     @db.VarChar(50)
  occupation                String                     @db.VarChar(100)
  status                    CharacterStatus            @default(DRAFT)
  visibility                CharacterVisibility        @default(PUBLIC)
  isFeatured                Boolean                    @default(false) @map("is_featured")
  sourceType                CharacterSourceType        @default(OFFICIAL) @map("source_type")
  creatorProfileId          String?                    @map("creator_profile_id") @db.Uuid
  creatorProfile            CreatorProfile?            @relation(fields: [creatorProfileId], references: [id], onDelete: SetNull)
  moderationStatus          CharacterModerationStatus  @default(DRAFT) @map("moderation_status")
  rejectionReason           String?                    @map("rejection_reason") @db.Text
  changeRequestDetails      String?                    @map("change_request_details") @db.Text
  accessType                String                     @default("free") @map("access_type") @db.VarChar(30) // 'free', 'entitlement', 'credit', 'subscription', 'campaign'
  requiredEntitlement       String?                    @map("required_entitlement") @db.VarChar(100)
  currentPublishedVersionId String?                    @map("current_published_version_id") @db.Uuid
  currentPublishedVersion   CharacterVersion?          @relation("CurrentPublishedVersion", fields: [currentPublishedVersionId], references: [id], onDelete: SetNull)
  currentVersionNumber      Int                        @default(1) @map("current_version_number")
  createdById               String?                    @map("created_by_id") @db.Uuid
  createdBy                 User?                      @relation("CharacterCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById               String?                    @map("updated_by_id") @db.Uuid
  versions                  CharacterVersion[]         @relation("CharacterVersions")
  traits                    CharacterTrait[]
  knowledgeItems            CharacterKnowledge[]
  conversations             Conversation[]
  relationships             Relationship[]
  memories                  Memory[]
  proactiveActions          ProactiveAction[]
  proactiveDecisionLogs     ProactiveDecisionLog[]
  userReminders             UserReminder[]
  evaluationTestCases       AIEvaluationTestCase[]
  evaluationRuns            AIEvaluationRun[]
  generationTraces          AIGenerationTrace[]
  voiceSessions             VoiceSession[]
  tagLinks                  CharacterTagLink[]
  discoveryConfig           CharacterDiscoveryConfig?
  collectionItems           CollectionItem[]
  favoritedBy               UserFavorite[]
  userSignals               UserCharacterSignal[]
  discoveryEventLogs        DiscoveryEventLog[]
  firstSessions             UserFirstSession[]
  activationFunnelLogs      ActivationFunnelLog[]
  moderationCases           ModerationCase[]
  characterReports          CharacterReport[]
  moderationAppeals         ModerationAppeal[]
  creatorProducts           CreatorProduct[]
  creatorEarnings           CreatorEarningsLedger[]
  blockedByUsers            UserBlock[]                @relation("BlockedCharacterTarget")
  socialFollowers           CharacterFollow[]
  socialContents            SocialContent[]
  socialCapability          CharacterSocialCapability?
  communities               Community[]
  safetyEvaluationLogs      SafetyEvaluationLog[]
  searchDocument            SearchDocument?
  primarySimilarities       CharacterSimilarity[]      @relation("PrimarySimilarCharacter")
  targetSimilarities        CharacterSimilarity[]      @relation("TargetSimilarCharacter")
  negativeSignals           UserNegativeSignal[]
  archivedAt                DateTime?                  @map("archived_at") @db.Timestamptz(6)
  deletedAt                 DateTime?                  @map("deleted_at") @db.Timestamptz(6)
  createdAt                 DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, visibility])
  @@index([category])
  @@index([categoryId])
  @@index([createdById])
  @@map("characters")
}

model CharacterVersion {
  id                        String                 @id @default(uuid()) @db.Uuid
  characterId               String                 @map("character_id") @db.Uuid
  character                 Character              @relation("CharacterVersions", fields: [characterId], references: [id], onDelete: Cascade)
  versionNumber             Int                    @map("version_number")
  status                    CharacterVersionStatus @default(DRAFT)
  identityData              Json                   @map("identity_data")
  personalityData           Json                   @map("personality_data")
  communicationData         Json                   @map("communication_data")
  languageData              Json                   @map("language_data")
  behaviorRulesData         Json                   @map("behavior_rules_data")
  knowledgeData             Json                   @map("knowledge_data")
  relationshipConfigData    Json                   @map("relationship_config_data")
  memoryConfigData          Json                   @map("memory_config_data")
  proactivityConfigData     Json                   @map("proactivity_config_data")
  safetyConfigData          Json                   @map("safety_config_data")
  aiConfigData              Json                   @map("ai_config_data")
  voiceConfigData           Json?                  @map("voice_config_data")
  compiledPromptSnapshot    String?                @map("compiled_prompt_snapshot") @db.Text
  changeSummary             String                 @map("change_summary") @db.VarChar(255)
  publishedAt               DateTime?              @map("published_at") @db.Timestamptz(6)
  createdById               String?                @map("created_by_id") @db.Uuid
  createdBy                 User?                  @relation("VersionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  asCurrentPublishedVersion Character[]            @relation("CurrentPublishedVersion")
  conversations             Conversation[]
  proactiveActions          ProactiveAction[]
  evaluationRuns            AIEvaluationRun[]
  generationTraces          AIGenerationTrace[]
  voiceSessions             VoiceSession[]
  moderationCases           ModerationCase[]
  createdAt                 DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([characterId, versionNumber])
  @@index([characterId, status])
  @@map("character_versions")
}

model CharacterTrait {
  id          String    @id @default(uuid()) @db.Uuid
  characterId String    @map("character_id") @db.Uuid
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  traitKey    String    @map("trait_key") @db.VarChar(50)
  traitValue  Float     @map("trait_value")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([characterId, traitKey])
  @@map("character_traits")
}

model CharacterKnowledge {
  id          String    @id @default(uuid()) @db.Uuid
  characterId String    @map("character_id") @db.Uuid
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  topic       String    @db.VarChar(100)
  content     String    @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([characterId, topic])
  @@map("character_knowledge")
}

// -----------------------------------------------------------------------------
// 5. Conversation & Messaging (Phase 4 Foundation)
// -----------------------------------------------------------------------------

model Conversation {
  id                    String                @id @default(uuid()) @db.Uuid
  userId                String                @map("user_id") @db.Uuid
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  characterId           String                @map("character_id") @db.Uuid
  character             Character             @relation(fields: [characterId], references: [id], onDelete: Cascade)
  characterVersionId    String?               @map("character_version_id") @db.Uuid
  characterVersion      CharacterVersion?     @relation(fields: [characterVersionId], references: [id], onDelete: SetNull)
  title                 String                @default("New Conversation") @db.VarChar(100)
  status                ConversationStatus    @default(ACTIVE)
  unreadCount           Int                   @default(0) @map("unread_count")
  lastMessageAt         DateTime?             @map("last_message_at") @db.Timestamptz(6)
  lastMessageSnippet    String?               @map("last_message_snippet") @db.VarChar(255)
  generationLockedUntil DateTime?             @map("generation_locked_until") @db.Timestamptz(6)
  messages              Message[]
  memories              Memory[]
  summaries             ConversationSummary[]
  proactiveActions      ProactiveAction[]
  voiceSessions         VoiceSession[]
  archivedAt            DateTime?             @map("archived_at") @db.Timestamptz(6)
  deletedAt             DateTime?             @map("deleted_at") @db.Timestamptz(6)
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, characterId])
  @@index([userId, status, lastMessageAt(sort: Desc)])
  @@map("conversations")
}

model Message {
  id                   String                     @id @default(uuid()) @db.Uuid
  conversationId       String                     @map("conversation_id") @db.Uuid
  conversation         Conversation               @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderType           MessageSenderType          @map("sender_type")
  senderId             String?                    @map("sender_id") @db.Uuid
  role                 String                     @default("user") @db.VarChar(20)
  content              String                     @db.Text
  status               MessageStatus              @default(SENT)
  idempotencyKey       String?                    @unique @map("idempotency_key") @db.VarChar(100)
  clientRequestId      String?                    @map("client_request_id") @db.VarChar(100)
  sequenceNumber       Int                        @default(1) @map("sequence_number")
  retryCount           Int                        @default(0) @map("retry_count")
  replyToMessageId     String?                    @map("reply_to_message_id") @db.Uuid
  mediaType            String                     @default("NONE") @map("media_type") @db.VarChar(20)
  mediaUrl             String?                    @map("media_url") @db.Text
  audioDurationSeconds Int?                       @map("audio_duration_seconds")
  isProactive          Boolean                    @default(false) @map("is_proactive")
  source               String                     @default("user") @map("source") @db.VarChar(30)
  promptTokens         Int?                       @map("prompt_tokens")
  completionTokens     Int?                       @map("completion_tokens")
  totalTokens          Int?                       @map("total_tokens")
  estimatedCostUsd     Float?                     @map("estimated_cost_usd")
  modelUsed            String?                    @map("model_used") @db.VarChar(100)
  providerUsed         String?                    @map("provider_used") @db.VarChar(50)
  characterVersionId   String?                    @map("character_version_id") @db.Uuid
  latencyMs            Int?                       @map("latency_ms")
  ttftMs               Int?                       @map("ttft_ms")
  parts                MessagePart[]
  metadata             MessageGenerationMetadata?
  feedback             MessageFeedback[]
  createdAt            DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([conversationId, sequenceNumber(sort: Asc)])
  @@index([conversationId, createdAt(sort: Desc)])
  @@index([clientRequestId])
  @@map("messages")
}

model MessagePart {
  id         String   @id @default(uuid()) @db.Uuid
  messageId  String   @map("message_id") @db.Uuid
  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  partType   String   @default("text") @map("part_type") @db.VarChar(30)
  content    String   @db.Text
  mediaUrl   String?  @map("media_url") @db.Text
  metadata   Json?
  orderIndex Int      @default(0) @map("order_index")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([messageId, orderIndex])
  @@map("message_parts")
}

model MessageGenerationMetadata {
  id                 String   @id @default(uuid()) @db.Uuid
  messageId          String   @unique @map("message_id") @db.Uuid
  message            Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  characterVersionId String   @map("character_version_id") @db.Uuid
  modelClass         String   @map("model_class") @db.VarChar(100)
  provider           String   @db.VarChar(50)
  temperature        Float?
  promptSnapshot     String?  @map("prompt_snapshot") @db.Text
  systemFingerprint  String?  @map("system_fingerprint") @db.VarChar(100)
  finishReason       String?  @map("finish_reason") @db.VarChar(50)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("message_generation_metadata")
}

model MessageFeedback {
  id             String   @id @default(uuid()) @db.Uuid
  messageId      String   @map("message_id") @db.Uuid
  message        Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId         String   @map("user_id") @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating         String   @db.VarChar(20) // 'THUMBS_UP', 'THUMBS_DOWN'
  feedbackText   String?  @map("feedback_text") @db.VarChar(1000)
  reasonCategory String?  @map("reason_category") @db.VarChar(100)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([messageId])
  @@index([userId])
  @@map("message_feedback")
}

// -----------------------------------------------------------------------------
// 6. Multi-Tier Memory System (Phase 5)
// -----------------------------------------------------------------------------

model Memory {
  id                   String            @id @default(uuid()) @db.Uuid
  userId               String            @map("user_id") @db.Uuid
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  characterId          String?           @map("character_id") @db.Uuid
  character            Character?        @relation(fields: [characterId], references: [id], onDelete: Cascade)
  conversationId       String?           @map("conversation_id") @db.Uuid
  conversation         Conversation?     @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  scope                MemoryScope       @default(CHARACTER_SPECIFIC)
  category             MemoryCategory    @default(PERSONAL_FACT)
  memoryType           MemoryType        @default(SEMANTIC_FACT) @map("memory_type")
  content              String            @db.Text
  normalizedContent    String?           @map("normalized_content") @db.Text
  importanceScore      Float             @default(0.5) @map("importance_score")
  confidenceScore      Float             @default(1.0) @map("confidence_score")
  sensitivity          MemorySensitivity @default(NORMAL)
  signalType           MemorySignalType  @default(IMPLICIT) @map("signal_type")
  status               MemoryStatus      @default(ACTIVE)
  supersededById       String?           @map("superseded_by_id") @db.Uuid
  supersededBy         Memory?           @relation("MemorySuperseding", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedingMemories  Memory[]          @relation("MemorySuperseding")
  sourceMessageId      String?           @map("source_message_id") @db.Uuid
  sourceConversationId String?           @map("source_conversation_id") @db.Uuid
  recallCount          Int               @default(0) @map("recall_count")
  lastRecalledAt       DateTime?         @map("last_recalled_at") @db.Timestamptz(6)
  reinforcementCount   Int               @default(1) @map("reinforcement_count")
  lastReinforcedAt     DateTime          @default(now()) @map("last_reinforced_at") @db.Timestamptz(6)
  expiresAt            DateTime?         @map("expires_at") @db.Timestamptz(6)
  deletedAt            DateTime?         @map("deleted_at") @db.Timestamptz(6)
  embeddings           MemoryEmbedding[]
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId, status, deletedAt])
  @@index([userId, characterId, scope, status])
  @@index([userId, category])
  @@map("memories")
}

model MemoryEmbedding {
  id               String   @id @default(uuid()) @db.Uuid
  memoryId         String   @map("memory_id") @db.Uuid
  memory           Memory   @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  modelName        String   @map("model_name") @db.VarChar(100)
  embeddingVersion String   @default("v1") @map("embedding_version") @db.VarChar(50)
  dimension        Int      @default(1536)
  embedding        Json?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([memoryId])
  @@map("memory_embeddings")
}

model ConversationSummary {
  id                  String       @id @default(uuid()) @db.Uuid
  conversationId      String       @map("conversation_id") @db.Uuid
  conversation        Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  summary             String       @db.Text
  keyFacts            Json         @default("[]") @map("key_facts")
  openTopics          Json         @default("[]") @map("open_topics")
  startSequenceNumber Int          @map("start_sequence_number")
  endSequenceNumber   Int          @map("end_sequence_number")
  messageCount        Int          @map("message_count")
  version             Int          @default(1)
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([conversationId, endSequenceNumber(sort: Desc)])
  @@map("conversation_summaries")
}

model UserMemorySettings {
  id                     String   @id @default(uuid()) @db.Uuid
  userId                 String   @unique @map("user_id") @db.Uuid
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  memoryEnabled          Boolean  @default(true) @map("memory_enabled")
  personalizationEnabled Boolean  @default(true) @map("personalization_enabled")
  allowSensitiveMemory   Boolean  @default(false) @map("allow_sensitive_memory")
  allowGlobalMemory      Boolean  @default(true) @map("allow_global_memory")
  retentionDays          Int      @default(365) @map("retention_days")
  excludedCharacterIds   Json     @default("[]") @map("excluded_character_ids")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("user_memory_settings")
}

model MemoryAccessLog {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  characterId        String?  @map("character_id") @db.Uuid
  queryContext       String   @map("query_context") @db.Text
  retrievedMemoryIds Json     @map("retrieved_memory_ids")
  totalCandidates    Int      @map("total_candidates")
  selectedCount      Int      @map("selected_count")
  latencyMs          Int      @map("latency_ms")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt(sort: Desc)])
  @@map("memory_access_logs")
}

// -----------------------------------------------------------------------------
// 7. Relationship Engine
// -----------------------------------------------------------------------------

model Relationship {
  id                    String                     @id @default(uuid()) @db.Uuid
  userId                String                     @map("user_id") @db.Uuid
  user                  User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  characterId           String                     @map("character_id") @db.Uuid
  character             Character                  @relation(fields: [characterId], references: [id], onDelete: Cascade)
  stage                 RelationshipStage          @default(STRANGER)
  familiarity           Float                      @default(0.0)
  trust                 Float                      @default(20.0)
  comfort               Float                      @default(20.0)
  affection             Float                      @default(10.0)
  engagement            Float                      @default(50.0)
  totalInteractions     Int                        @default(0) @map("total_interactions")
  consecutiveDaysActive Int                        @default(0) @map("consecutive_days_active")
  lastInteractionAt     DateTime?                  @map("last_interaction_at") @db.Timestamptz(6)
  version               Int                        @default(1)
  events                RelationshipEvent[]
  history               RelationshipStateHistory[]
  milestones            RelationshipMilestone[]
  createdAt             DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, characterId])
  @@index([userId, stage])
  @@index([characterId, stage])
  @@map("relationships")
}

model RelationshipStateHistory {
  id                  String            @id @default(uuid()) @db.Uuid
  relationshipId      String            @map("relationship_id") @db.Uuid
  relationship        Relationship      @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  previousStage       RelationshipStage @map("previous_stage")
  newStage            RelationshipStage @map("new_stage")
  previousFamiliarity Float             @map("previous_familiarity")
  newFamiliarity      Float             @map("new_familiarity")
  previousTrust       Float             @map("previous_trust")
  newTrust            Float             @map("new_trust")
  previousComfort     Float             @map("previous_comfort")
  newComfort          Float             @map("new_comfort")
  previousAffection   Float             @map("previous_affection")
  newAffection        Float             @map("new_affection")
  previousEngagement  Float             @map("previous_engagement")
  newEngagement       Float             @map("new_engagement")
  reason              String            @db.VarChar(255)
  eventId             String?           @map("event_id") @db.Uuid
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([relationshipId, createdAt(sort: Desc)])
  @@map("relationship_state_history")
}

model RelationshipEvent {
  id                   String       @id @default(uuid()) @db.Uuid
  relationshipId       String       @map("relationship_id") @db.Uuid
  relationship         Relationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  eventType            String       @map("event_type") @db.VarChar(50)
  importance           Float        @default(0.5)
  confidence           Float        @default(0.8)
  deltaFamiliarity     Float        @default(0.0) @map("delta_familiarity")
  deltaTrust           Float        @default(0.0) @map("delta_trust")
  deltaComfort         Float        @default(0.0) @map("delta_comfort")
  deltaAffection       Float        @default(0.0) @map("delta_affection")
  deltaEngagement      Float        @default(0.0) @map("delta_engagement")
  description          String       @db.VarChar(255)
  sourceConversationId String?      @map("source_conversation_id") @db.Uuid
  sourceMessageId      String?      @map("source_message_id") @db.Uuid
  metadata             Json?        @db.JsonB
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([relationshipId, createdAt(sort: Desc)])
  @@index([eventType])
  @@map("relationship_events")
}

model RelationshipMilestone {
  id                   String       @id @default(uuid()) @db.Uuid
  relationshipId       String       @map("relationship_id") @db.Uuid
  relationship         Relationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  milestoneType        String       @map("milestone_type") @db.VarChar(50)
  title                String       @db.VarChar(150)
  description          String       @db.VarChar(500)
  sourceConversationId String?      @map("source_conversation_id") @db.Uuid
  achievedAt           DateTime     @default(now()) @map("achieved_at") @db.Timestamptz(6)

  @@unique([relationshipId, milestoneType])
  @@index([relationshipId, achievedAt(sort: Desc)])
  @@map("relationship_milestones")
}

model UserRelationshipSettings {
  userId                         String   @id @map("user_id") @db.Uuid
  user                           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  personalizationEnabled         Boolean  @default(true) @map("personalization_enabled")
  relationshipProgressionEnabled Boolean  @default(true) @map("relationship_progression_enabled")
  updatedAt                      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("user_relationship_settings")
}

// -----------------------------------------------------------------------------
// 9. System Governance
// -----------------------------------------------------------------------------

model FeatureFlag {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(100)
  description String   @db.VarChar(255)
  isEnabled   Boolean  @default(false) @map("is_enabled")
  rolloutPct  Int      @default(0) @map("rollout_pct")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("feature_flags")
}

// -----------------------------------------------------------------------------
// 10. Proactive AI & Notification Intelligence (Phase 7)
// -----------------------------------------------------------------------------

model UserDevice {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId             String    @map("device_id") @db.VarChar(150)
  pushToken            String?   @map("push_token") @db.VarChar(500)
  platform             String    @db.VarChar(20) // 'ios', 'android', 'web'
  appVersion           String?   @map("app_version") @db.VarChar(50)
  pushPermissionStatus String    @default("NOT_DETERMINED") @map("push_permission_status") @db.VarChar(30)
  isActive             Boolean   @default(true) @map("is_active")
  lastSeenAt           DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  invalidatedAt        DateTime? @map("invalidated_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, deviceId])
  @@index([userId, isActive])
  @@index([pushToken])
  @@map("user_devices")
}

model UserNotificationPreference {
  userId                          String   @id @map("user_id") @db.Uuid
  user                            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushEnabled                     Boolean  @default(true) @map("push_enabled")
  proactivityEnabled              Boolean  @default(true) @map("proactivity_enabled")
  quietHoursEnabled               Boolean  @default(true) @map("quiet_hours_enabled")
  quietHoursStart                 String   @default("22:30") @map("quiet_hours_start") @db.VarChar(10)
  quietHoursEnd                   String   @default("08:00") @map("quiet_hours_end") @db.VarChar(10)
  timezone                        String   @default("UTC") @db.VarChar(50)
  maxDailyNotifications           Int      @default(3) @map("max_daily_notifications")
  maxWeeklyNotifications          Int      @default(14) @map("max_weekly_notifications")
  showPreview                     Boolean  @default(true) @map("show_preview")
  lockScreenPrivacy               String   @default("FULL_PREVIEW") @map("lock_screen_privacy") @db.VarChar(30) // FULL_PREVIEW, LIMITED_PREVIEW, HIDE_CONTENT
  characterMessageCategoryEnabled Boolean  @default(true) @map("character_message_category_enabled")
  userReminderCategoryEnabled     Boolean  @default(true) @map("user_reminder_category_enabled")
  recommendationsCategoryEnabled  Boolean  @default(true) @map("recommendations_category_enabled")
  productUpdatesCategoryEnabled   Boolean  @default(true) @map("product_updates_category_enabled")
  systemCategoryEnabled           Boolean  @default(true) @map("system_category_enabled")
  billingCategoryEnabled          Boolean  @default(true) @map("billing_category_enabled")
  securityCategoryEnabled         Boolean  @default(true) @map("security_category_enabled")
  marketingCategoryEnabled        Boolean  @default(false) @map("marketing_category_enabled")
  mutedCharacterIds               String[] @default([]) @map("muted_character_ids")
  /// Per-category social PUSH opt-ins (in-app delivery is governed separately). Missing key = category default.
  socialCategoryPush              Json     @default("{}") @map("social_category_push") @db.JsonB
  characterOverrides              Json?    @map("character_overrides") @db.JsonB
  updatedAt                       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("user_notification_preferences")
}

model InAppNotification {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   String    @db.VarChar(50) // 'character_message', 'conversation_reply', 'system', 'security', 'billing', 'product_update', 'reminder', 'campaign', 'recommendations'
  title      String    @db.VarChar(150)
  body       String    @db.Text
  deepLink   String?   @map("deep_link") @db.VarChar(255)
  data       Json?     @db.JsonB
  isRead     Boolean   @default(false) @map("is_read")
  readAt     DateTime? @map("read_at") @db.Timestamptz(6)
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(6)
  sourceType String?   @map("source_type") @db.VarChar(50)
  sourceId   String?   @map("source_id") @db.VarChar(100)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@index([userId, category])
  @@map("in_app_notifications")
}

model NotificationCampaign {
  id                String    @id @default(uuid()) @db.Uuid
  title             String    @db.VarChar(150)
  description       String?   @db.Text
  category          String    @default("product_update") @db.VarChar(50)
