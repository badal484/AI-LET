/// Explicit multi-turn user goals tracked by character and session
model UserGoal {
  id              String    @id @default(uuid()) @db.VarChar(100)
  userId          String    @map("user_id") @db.VarChar(100)
  characterId     String?   @map("character_id") @db.VarChar(100)
  conversationId  String?   @map("conversation_id") @db.VarChar(100)
  category        String    @db.VarChar(60) // travel_planning, interview_prep, study, coding, research, writing, general
  title           String    @db.VarChar(200)
  status          String    @default("active") @db.VarChar(30) // created, active, paused, blocked, awaiting_input, awaiting_confirmation, executing, completed, cancelled, expired, failed
  priority        Int       @default(0)
  progress        Float     @default(0.0)
  constraints     Json?     @db.JsonB
  activeTaskId    String?   @map("active_task_id") @db.VarChar(100)
  metadata        Json?     @db.JsonB
  lastActiveAt    DateTime  @default(now()) @map("last_active_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tasks           AgentTaskRecord[]

  @@index([userId, status])
  @@index([userId, lastActiveAt(sort: Desc)])
  @@index([characterId])
  @@map("user_goals")
}

/// Durable record for agent tasks replacing in-memory Task maps
model AgentTaskRecord {
  id               String               @id @db.VarChar(100)
  userId           String               @map("user_id") @db.VarChar(100)
  characterId      String?              @map("character_id") @db.VarChar(100)
  conversationId   String?              @map("conversation_id") @db.VarChar(100)
  goalId           String?              @map("goal_id") @db.VarChar(100)
  goal             UserGoal?            @relation(fields: [goalId], references: [id], onDelete: SetNull)
  taskType         String               @map("task_type") @db.VarChar(40) // WORKFLOW, ONE_SHOT_TOOL, RESEARCH, MULTIMODAL_EXTRACTION, SCHEDULED_AUTOMATION
  objective        String               @db.Text
  status           String               @default("created") @db.VarChar(30)
  currentStepIndex Int                  @default(0) @map("current_step_index")
  bounds           Json                 @db.JsonB
  planId           String?              @map("plan_id") @db.VarChar(100)
  plan             AgentPlanRecord?
  estimatedCostUsd Float                @default(0.0) @map("estimated_cost_usd")
  actualCostUsd    Float                @default(0.0) @map("actual_cost_usd")
  failureCode      String?              @map("failure_code") @db.VarChar(60)
  failureReason    String?              @map("failure_reason") @db.Text
  metadata         Json?                @db.JsonB
  startedAt        DateTime?            @map("started_at") @db.Timestamptz(6)
  completedAt      DateTime?            @map("completed_at") @db.Timestamptz(6)
  cancelledAt      DateTime?            @map("cancelled_at") @db.Timestamptz(6)
  expiresAt        DateTime             @map("expires_at") @db.Timestamptz(6)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  checkpoints      AgentTaskCheckpoint[]

  @@index([userId, status])
  @@index([characterId])
  @@index([goalId])
  @@index([expiresAt])
  @@map("agent_tasks")
}

/// Structured plan generated for an AgentTask
model AgentPlanRecord {
  id                  String          @id @db.VarChar(100)
  taskId              String          @unique @map("task_id") @db.VarChar(100)
  task                AgentTaskRecord @relation(fields: [taskId], references: [id], onDelete: Cascade)
  objective           String          @db.Text
  steps               Json            @db.JsonB
  estimatedCostUsd    Float           @default(0.0) @map("estimated_cost_usd")
  estimatedDurationMs Int             @default(0) @map("estimated_duration_ms")
  requiredPermissions Json            @map("required_permissions") @db.JsonB
  riskLevel           String          @map("risk_level") @db.VarChar(20)
  generatedByModel    String          @map("generated_by_model") @db.VarChar(100)
  promptVersion       String          @map("prompt_version") @db.VarChar(50)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("agent_plans")
}

/// Resumable checkpoints for multi-step tasks preventing re-execution upon crashes
model AgentTaskCheckpoint {
  id                String          @id @default(uuid()) @db.VarChar(100)
  taskId            String          @map("task_id") @db.VarChar(100)
  task              AgentTaskRecord @relation(fields: [taskId], references: [id], onDelete: Cascade)
  stepIndex         Int             @map("step_index")
  stepId            String          @map("step_id") @db.VarChar(100)
  stateSnapshot     Json            @map("state_snapshot") @db.JsonB
  accumulatedOutput Json?           @map("accumulated_output") @db.JsonB
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([taskId, stepIndex])
  @@map("agent_task_checkpoints")
}

/// High-risk confirmation tokens bound to exact args hash and expiration
model HighRiskConfirmationRecord {
  token             String    @id @db.VarChar(100)
  userId            String    @map("user_id") @db.VarChar(100)
  taskId            String    @map("task_id") @db.VarChar(100)
  stepId            String    @map("step_id") @db.VarChar(100)
  toolSlug          String    @map("tool_slug") @db.VarChar(100)
  argumentsHash     String    @map("arguments_hash") @db.VarChar(64)
  riskLevel         String    @map("risk_level") @db.VarChar(20)
  explanation       String    @db.Text
  proposedArguments Json      @map("proposed_arguments") @db.JsonB
  isUsed            Boolean   @default(false) @map("is_used")
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, isUsed])
  @@index([token, argumentsHash])
  @@map("high_risk_confirmations")
}

/// Durable skill registry with bounded capabilities
model SkillRecord {
  id                   String               @id @default(uuid()) @db.VarChar(100)
  slug                 String               @unique @db.VarChar(80)
  name                 String               @db.VarChar(120)
