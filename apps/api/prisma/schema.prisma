model VoiceSession {
  id                   String             @id @default(uuid()) @db.Uuid
  userId               String             @map("user_id") @db.Uuid
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  characterId          String             @map("character_id") @db.Uuid
  character            Character          @relation(fields: [characterId], references: [id], onDelete: Cascade)
  characterVersionId   String?            @map("character_version_id") @db.Uuid
  characterVersion     CharacterVersion?  @relation(fields: [characterVersionId], references: [id], onDelete: SetNull)
  conversationId       String?            @map("conversation_id") @db.Uuid
  conversation         Conversation?      @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  status               String             @default("created") @db.VarChar(30)
  voiceMode            String             @default("hands_free") @map("voice_mode") @db.VarChar(30)
  transport            String             @default("websocket") @db.VarChar(30)
  language             String             @default("en") @db.VarChar(10)
  voiceId              String             @map("voice_id") @db.VarChar(100)
  provider             String             @db.VarChar(50)
  totalDurationSeconds Int                @default(0) @map("total_duration_seconds")
  userSpeakingSeconds  Int                @default(0) @map("user_speaking_seconds")
  aiSpeakingSeconds    Int                @default(0) @map("ai_speaking_seconds")
  turnsCount           Int                @default(0) @map("turns_count")
  interruptionCount    Int                @default(0) @map("interruption_count")
  totalCostUsd         Float              @default(0.0) @map("total_cost_usd")
  metadata             Json?              @db.JsonB
  startedAt            DateTime           @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt              DateTime?          @map("ended_at") @db.Timestamptz(6)
  lastActivityAt       DateTime           @default(now()) @map("last_activity_at") @db.Timestamptz(6)
  turns                VoiceSessionTurn[]
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId, status])
  @@index([characterId, status])
  @@index([createdAt(sort: Desc)])
  @@map("voice_sessions")
}

model VoiceSessionTurn {
  id                   String       @id @default(uuid()) @db.Uuid
  sessionId            String       @map("session_id") @db.Uuid
  session              VoiceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  turnIndex            Int          @map("turn_index")
  userTranscript       String       @map("user_transcript") @db.Text
  userSpeechDurationMs Int          @default(0) @map("user_speech_duration_ms")
  sttLatencyMs         Int          @default(0) @map("stt_latency_ms")
  sttConfidence        Float        @default(1.0) @map("stt_confidence")
  aiResponseText       String       @default("") @map("ai_response_text") @db.Text
  llmFirstTokenMs      Int          @default(0) @map("llm_first_token_ms")
  llmTotalMs           Int          @default(0) @map("llm_total_ms")
  ttsFirstAudioMs      Int          @default(0) @map("tts_first_audio_ms")
  ttsTotalMs           Int          @default(0) @map("tts_total_ms")
  totalTurnLatencyMs   Int          @default(0) @map("total_turn_latency_ms")
  interrupted          Boolean      @default(false)
  interruptedAtMs      Int?         @map("interrupted_at_ms")
  sttCostUsd           Float        @default(0.0) @map("stt_cost_usd")
  llmCostUsd           Float        @default(0.0) @map("llm_cost_usd")
  ttsCostUsd           Float        @default(0.0) @map("tts_cost_usd")
  totalCostUsd         Float        @default(0.0) @map("total_cost_usd")
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([sessionId, turnIndex])
  @@map("voice_session_turns")
}

model UserVoicePreference {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  voiceEnabled      Boolean  @default(true) @map("voice_enabled")
  preferredMode     String   @default("hands_free") @map("preferred_mode") @db.VarChar(30)
  speechSpeed       Float    @default(1.0) @map("speech_speed")
  preferredLanguage String   @default("en") @map("preferred_language") @db.VarChar(10)
  subtitlesEnabled  Boolean  @default(true) @map("subtitles_enabled")
  autoPlayAudio     Boolean  @default(true) @map("auto_play_audio")
  noiseSuppression  Boolean  @default(true) @map("noise_suppression")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("user_voice_preferences")
}

// -----------------------------------------------------------------------------
// 12. Monetization, Subscriptions, Credits, Entitlements & Billing (Phase 11)
// -----------------------------------------------------------------------------

enum ProductType {
  SUBSCRIPTION
  ONE_TIME
  CREDIT_PACK
  ADD_ON
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
  DRAFT
}

enum BillingProvider {
  APPLE
  GOOGLE
  STRIPE
  MOCK
}

enum PriceCurrency {
  INR
  USD
  EUR
  GBP
}

enum PlanInterval {
  MONTH
  YEAR
  ONE_TIME
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  GRACE_PERIOD
  PAUSED
  CANCELLED
  EXPIRED
  INCOMPLETE
  PAYMENT_FAILED
}

enum EntitlementSource {
  SUBSCRIPTION
  PROMOTION
  ONE_TIME
  ADMIN_GRANT
  TRIAL
  SYSTEM_FREE
}

enum UsageReservationStatus {
  RESERVED
  CONSUMED
  RELEASED
  EXPIRED
}

enum CreditTransactionType {
  PURCHASE
  GRANT
  CONSUMPTION
  REFUND
  EXPIRATION
  ADJUSTMENT
  REVERSAL
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  DISPUTED
}

enum WebhookProcessingStatus {
  RECEIVED
  VERIFIED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

enum PromoDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_CREDITS
  TRIAL_EXTENSION
}

enum ReconciliationStatus {
  MATCH
  MISMATCH
  RESOLVED
}

model BillingProduct {
  id          String         @id @default(uuid()) @db.Uuid
  name        String         @db.VarChar(100)
  slug        String         @unique @db.VarChar(100)
  description String         @default("") @db.VarChar(1000)
  type        ProductType    @default(SUBSCRIPTION)
  status      ProductStatus  @default(ACTIVE)
  metadata    Json?          @db.JsonB
  plans       BillingPlan[]
  prices      BillingPrice[]
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("billing_products")
}

model BillingPlan {
  id            String                @id @default(uuid()) @db.Uuid
  productId     String                @map("product_id") @db.Uuid
  product       BillingProduct        @relation(fields: [productId], references: [id], onDelete: Cascade)
  code          String                @unique @db.VarChar(50) // 'FREE', 'PLUS', 'PRO', 'ULTRA'
  name          String                @db.VarChar(100)
  tagline       String                @default("") @db.VarChar(255)
  description   String                @default("") @db.Text
  isActive      Boolean               @default(true) @map("is_active")
  isPopular     Boolean               @default(false) @map("is_popular")
  trialDays     Int                   @default(0) @map("trial_days")
  metadata      Json?                 @db.JsonB
  entitlements  PlanEntitlement[]
  usageLimits   PlanUsageLimit[]
  prices        BillingPrice[]
  subscriptions BillingSubscription[]
  promotions    BillingPromotion[]
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive])
  @@map("billing_plans")
}

model BillingPrice {
  id                   String                @id @default(uuid()) @db.Uuid
  productId            String                @map("product_id") @db.Uuid
  product              BillingProduct        @relation(fields: [productId], references: [id], onDelete: Cascade)
  planId               String?               @map("plan_id") @db.Uuid
  plan                 BillingPlan?          @relation(fields: [planId], references: [id], onDelete: Cascade)
  currency             PriceCurrency         @default(USD)
  amountMinorUnits     Int                   @map("amount_minor_units") // integer minor units e.g. 999 for $9.99
  billingInterval      PlanInterval?         @map("billing_interval")
  billingIntervalCount Int                   @default(1) @map("billing_interval_count")
  provider             BillingProvider       @default(MOCK)
  providerPriceId      String                @map("provider_price_id") @db.VarChar(100)
  country              String?               @db.VarChar(10)
  active               Boolean               @default(true)
  effectiveFrom        DateTime?             @map("effective_from") @db.Timestamptz(6)
  effectiveUntil       DateTime?             @map("effective_until") @db.Timestamptz(6)
  metadata             Json?                 @db.JsonB
  subscriptions        BillingSubscription[]
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([provider, providerPriceId])
  @@index([productId, planId])
  @@map("billing_prices")
}

model PlanEntitlement {
  id             String      @id @default(uuid()) @db.Uuid
  planId         String      @map("plan_id") @db.Uuid
  plan           BillingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  entitlementKey String      @map("entitlement_key") @db.VarChar(100)
  metadata       Json?       @db.JsonB
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([planId, entitlementKey])
  @@map("plan_entitlements")
}

model PlanUsageLimit {
  id          String      @id @default(uuid()) @db.Uuid
  planId      String      @map("plan_id") @db.Uuid
  plan        BillingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  meterUnit   String      @map("meter_unit") @db.VarChar(50)
  limitAmount Int         @map("limit_amount")
  period      String      @default("month") @db.VarChar(20)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([planId, meterUnit])
  @@map("plan_usage_limits")
}

model BillingSubscription {
  id                     String                  @id @default(uuid()) @db.Uuid
  userId                 String                  @map("user_id") @db.Uuid
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId                 String                  @map("plan_id") @db.Uuid
  plan                   BillingPlan             @relation(fields: [planId], references: [id], onDelete: Restrict)
  priceId                String?                 @map("price_id") @db.Uuid
  price                  BillingPrice?           @relation(fields: [priceId], references: [id], onDelete: SetNull)
  status                 SubscriptionStatus      @default(ACTIVE)
  provider               BillingProvider         @default(MOCK)
  providerSubscriptionId String?                 @unique @map("provider_subscription_id") @db.VarChar(255)
  currentPeriodStart     DateTime                @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd       DateTime                @map("current_period_end") @db.Timestamptz(6)
  trialStart             DateTime?               @map("trial_start") @db.Timestamptz(6)
  trialEnd               DateTime?               @map("trial_end") @db.Timestamptz(6)
  cancelAtPeriodEnd      Boolean                 @default(false) @map("cancel_at_period_end")
  cancelledAt            DateTime?               @map("cancelled_at") @db.Timestamptz(6)
  endedAt                DateTime?               @map("ended_at") @db.Timestamptz(6)
  gracePeriodEnd         DateTime?               @map("grace_period_end") @db.Timestamptz(6)
  metadata               Json?                   @db.JsonB
  transactions           PurchaseTransaction[]
  invoices               BillingInvoice[]
  reconciliations        BillingReconciliation[]
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId, status])
  @@index([provider, status])
  @@map("billing_subscriptions")
}

model UserEntitlement {
  id             String            @id @default(uuid()) @db.Uuid
  userId         String            @map("user_id") @db.Uuid
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  entitlementKey String            @map("entitlement_key") @db.VarChar(100)
  source         EntitlementSource @default(SUBSCRIPTION)
  sourceId       String?           @map("source_id") @db.VarChar(100)
  grantedAt      DateTime          @default(now()) @map("granted_at") @db.Timestamptz(6)
  expiresAt      DateTime?         @map("expires_at") @db.Timestamptz(6)
  isActive       Boolean           @default(true) @map("is_active")
  metadata       Json?             @db.JsonB
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, entitlementKey, source, sourceId])
  @@index([userId, isActive, expiresAt])
  @@map("user_entitlements")
}

model UsageMeter {
  id             String             @id @default(uuid()) @db.Uuid
  userId         String             @map("user_id") @db.Uuid
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  meterUnit      String             @map("meter_unit") @db.VarChar(50)
  periodStart    DateTime           @map("period_start") @db.Timestamptz(6)
  periodEnd      DateTime           @map("period_end") @db.Timestamptz(6)
  limitAmount    Int                @default(0) @map("limit_amount")
  consumedAmount Int                @default(0) @map("consumed_amount")
  reservedAmount Int                @default(0) @map("reserved_amount")
  version        Int                @default(1)
  reservations   UsageReservation[]
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, meterUnit, periodStart, periodEnd])
  @@index([userId, meterUnit])
  @@map("usage_meters")
}

model UsageReservation {
  id             String                 @id @default(uuid()) @db.Uuid
  usageMeterId   String                 @map("usage_meter_id") @db.Uuid
  usageMeter     UsageMeter             @relation(fields: [usageMeterId], references: [id], onDelete: Cascade)
  userId         String                 @map("user_id") @db.Uuid
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  meterUnit      String                 @map("meter_unit") @db.VarChar(50)
  reservedAmount Int                    @map("reserved_amount")
  consumedAmount Int                    @default(0) @map("consumed_amount")
  status         UsageReservationStatus @default(RESERVED)
  idempotencyKey String?                @unique @map("idempotency_key") @db.VarChar(100)
  expiresAt      DateTime               @map("expires_at") @db.Timestamptz(6)
  settledAt      DateTime?              @map("settled_at") @db.Timestamptz(6)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([usageMeterId, status])
  @@index([userId, status, expiresAt])
  @@map("usage_reservations")
}

model CreditWallet {
  id                 String              @id @default(uuid()) @db.Uuid
  userId             String              @unique @map("user_id") @db.Uuid
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  availableBalance   Int                 @default(0) @map("available_balance")
  purchasedCredits   Int                 @default(0) @map("purchased_credits")
  promotionalCredits Int                 @default(0) @map("promotional_credits")
  version            Int                 @default(1)
  transactions       CreditTransaction[]
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("credit_wallets")
}

model CreditTransaction {
  id             String                @id @default(uuid()) @db.Uuid
  walletId       String                @map("wallet_id") @db.Uuid
  wallet         CreditWallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  userId         String                @map("user_id") @db.Uuid
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           CreditTransactionType
  amount         Int // positive for grants/purchases, negative for consumption
  balanceAfter   Int                   @map("balance_after")
  idempotencyKey String                @unique @map("idempotency_key") @db.VarChar(100)
  referenceType  String?               @map("reference_type") @db.VarChar(50) // 'PURCHASE', 'VOICE_SESSION', 'AI_GENERATION', 'ADMIN_GRANT'
  referenceId    String?               @map("reference_id") @db.VarChar(100)
  description    String                @db.VarChar(255)
  expiresAt      DateTime?             @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([walletId, createdAt(sort: Desc)])
  @@index([userId, type])
  @@map("credit_transactions")
}

model PurchaseTransaction {
  id                    String               @id @default(uuid()) @db.Uuid
  userId                String               @map("user_id") @db.Uuid
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId        String?              @map("subscription_id") @db.Uuid
  subscription          BillingSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  provider              BillingProvider      @default(MOCK)
  providerTransactionId String               @unique @map("provider_transaction_id") @db.VarChar(255)
  idempotencyKey        String?              @unique @map("idempotency_key") @db.VarChar(100)
  productId             String               @map("product_id") @db.VarChar(100)
  currency              PriceCurrency        @default(USD)
  amountMinorUnits      Int                  @map("amount_minor_units")
  status                PaymentStatus        @default(SUCCEEDED)
  rawReceiptData        String?              @map("raw_receipt_data") @db.Text
  refundReason          String?              @map("refund_reason") @db.VarChar(255)
  refundedAt            DateTime?            @map("refunded_at") @db.Timestamptz(6)
  metadata              Json?                @db.JsonB
  invoices              BillingInvoice[]
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId, status])
  @@index([provider, status])
  @@map("purchase_transactions")
}

model BillingInvoice {
  id             String               @id @default(uuid()) @db.Uuid
  subscriptionId String?              @map("subscription_id") @db.Uuid
  subscription   BillingSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  transactionId  String?              @map("transaction_id") @db.Uuid
  transaction    PurchaseTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  invoiceNumber  String               @unique @map("invoice_number") @db.VarChar(50)
  currency       PriceCurrency        @default(USD)
  subtotalMinor  Int                  @map("subtotal_minor")
  taxMinor       Int                  @default(0) @map("tax_minor")
  totalMinor     Int                  @map("total_minor")
  status         PaymentStatus        @default(SUCCEEDED)
  invoicePdfUrl  String?              @map("invoice_pdf_url") @db.Text
  periodStart    DateTime             @map("period_start") @db.Timestamptz(6)
  periodEnd      DateTime             @map("period_end") @db.Timestamptz(6)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("billing_invoices")
}

model BillingWebhookEvent {
  id              String                  @id @default(uuid()) @db.Uuid
  provider        BillingProvider
  providerEventId String                  @map("provider_event_id") @db.VarChar(255)
  eventType       String                  @map("event_type") @db.VarChar(100)
  status          WebhookProcessingStatus @default(RECEIVED)
  payload         Json                    @db.JsonB
  signature       String?                 @db.Text
  retryCount      Int                     @default(0) @map("retry_count")
  failureReason   String?                 @map("failure_reason") @db.Text
  processedAt     DateTime?               @map("processed_at") @db.Timestamptz(6)
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([provider, providerEventId])
  @@index([status, retryCount])
  @@map("billing_webhook_events")
}

model BillingPromotion {
  id                 String            @id @default(uuid()) @db.Uuid
  code               String            @unique @db.VarChar(50)
  name               String            @db.VarChar(100)
  description        String            @default("") @db.VarChar(500)
  discountType       PromoDiscountType @default(PERCENTAGE) @map("discount_type")
  discountValue      Float             @map("discount_value")
  planId             String?           @map("plan_id") @db.Uuid
  plan               BillingPlan?      @relation(fields: [planId], references: [id], onDelete: SetNull)
  maxRedemptions     Int?              @map("max_redemptions")
  currentRedemptions Int               @default(0) @map("current_redemptions")
  perUserLimit       Int               @default(1) @map("per_user_limit")
  validFrom          DateTime          @default(now()) @map("valid_from") @db.Timestamptz(6)
  validUntil         DateTime?         @map("valid_until") @db.Timestamptz(6)
  isActive           Boolean           @default(true) @map("is_active")
  targetAudience     String?           @map("target_audience") @db.VarChar(100)
  redemptions        PromoRedemption[]
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([code, isActive])
  @@map("billing_promotions")
}

model PromoRedemption {
  id          String           @id @default(uuid()) @db.Uuid
  promotionId String           @map("promotion_id") @db.Uuid
  promotion   BillingPromotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  userId      String           @map("user_id") @db.Uuid
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  redeemedAt  DateTime         @default(now()) @map("redeemed_at") @db.Timestamptz(6)

  @@unique([promotionId, userId, id])
  @@index([userId, promotionId])
  @@map("promo_redemptions")
}

model BillingReconciliation {
  id             String               @id @default(uuid()) @db.Uuid
  userId         String               @map("user_id") @db.Uuid
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId String?              @map("subscription_id") @db.Uuid
  subscription   BillingSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  provider       BillingProvider      @default(MOCK)
  providerState  Json                 @map("provider_state") @db.JsonB
  internalState  Json                 @map("internal_state") @db.JsonB
  status         ReconciliationStatus @default(MATCH)
  mismatchReason String?              @map("mismatch_reason") @db.VarChar(255)
  resolvedAt     DateTime?            @map("resolved_at") @db.Timestamptz(6)
  resolvedBy     String?              @map("resolved_by") @db.VarChar(100)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, createdAt(sort: Desc)])
  @@index([userId])
  @@map("billing_reconciliations")
}

model BillingAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  adminUserId String?  @map("admin_user_id") @db.Uuid
  actorType   String   @default("ADMIN") @map("actor_type") @db.VarChar(20) // 'ADMIN', 'SYSTEM', 'USER'
  action      String   @db.VarChar(100) // 'PLAN_CREATED', 'PRICE_CHANGED', 'PROMOTION_CREATED', 'CREDITS_GRANTED', etc.
  targetType  String   @map("target_type") @db.VarChar(50)
  targetId    String?  @map("target_id") @db.VarChar(100)
  beforeState Json?    @map("before_state") @db.JsonB
  afterState  Json?    @map("after_state") @db.JsonB
  reason      String?  @db.VarChar(500)
  requestId   String?  @map("request_id") @db.VarChar(100)
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([action, createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@map("billing_audit_logs")
}

// -----------------------------------------------------------------------------
// 12. Production Home, Discovery, Character Catalog, Search & Recommendations (Phase 12 Foundation)
// -----------------------------------------------------------------------------

enum DiscoveryEventType {
  IMPRESSION
  CLICK
  DETAIL_VIEW
  CHAT_START
  FAVORITE
  DISMISS
}

enum HomeSectionLayout {
  HERO
  CAROUSEL
  GRID
  BANNER
  CHIPS
}

model CharacterCategory {
  id               String                     @id @default(uuid()) @db.Uuid
  slug             String                     @unique @db.VarChar(100)
  name             String                     @db.VarChar(100)
  displayName      String                     @map("display_name") @db.VarChar(100)
  description      String                     @default("") @db.VarChar(500)
  iconUrl          String?                    @map("icon_url") @db.Text
  coverImageUrl    String?                    @map("cover_image_url") @db.Text
  displayOrder     Int                        @default(0) @map("display_order")
  isActive         Boolean                    @default(true) @map("is_active")
  isFeatured       Boolean                    @default(false) @map("is_featured")
  tags             CharacterTag[]
  characters       Character[]
  discoveryConfigs CharacterDiscoveryConfig[]
  createdAt        DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive, displayOrder])
  @@map("character_categories")
}

model CharacterTag {
  id           String             @id @default(uuid()) @db.Uuid
  slug         String             @unique @db.VarChar(100)
  name         String             @db.VarChar(100)
  displayName  String             @map("display_name") @db.VarChar(100)
  description  String             @default("") @db.VarChar(500)
  categoryId   String?            @map("category_id") @db.Uuid
  category     CharacterCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  isCurated    Boolean            @default(true) @map("is_curated")
  displayOrder Int                @default(0) @map("display_order")
  tagLinks     CharacterTagLink[]
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([categoryId])
  @@index([isCurated, displayOrder])
  @@map("character_tags")
}

model CharacterTagLink {
  id          String       @id @default(uuid()) @db.Uuid
  characterId String       @map("character_id") @db.Uuid
  character   Character    @relation(fields: [characterId], references: [id], onDelete: Cascade)
  tagId       String       @map("tag_id") @db.Uuid
  tag         CharacterTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([characterId, tagId])
  @@index([tagId])
  @@map("character_tag_links")
}

model CharacterDiscoveryConfig {
  id                      String             @id @default(uuid()) @db.Uuid
  characterId             String             @unique @map("character_id") @db.Uuid
  character               Character          @relation(fields: [characterId], references: [id], onDelete: Cascade)
  categoryId              String?            @map("category_id") @db.Uuid
  category                CharacterCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  isDiscoverable          Boolean            @default(true) @map("is_discoverable")
  isSearchable            Boolean            @default(true) @map("is_searchable")
