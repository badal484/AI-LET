/// Immutable runtime snapshot for generation explainability and audit
model CharacterRuntimeSnapshot {
  id                  String    @id @default(uuid()) @db.VarChar(100)
  conversationId      String    @map("conversation_id") @db.VarChar(100)
  messageId           String?   @map("message_id") @db.VarChar(100)
  characterId         String    @map("character_id") @db.VarChar(100)
  characterVersionId  String    @map("character_version_id") @db.VarChar(100)
  promptVersion       String    @map("prompt_version") @db.VarChar(50)
  behaviorPolicyHash  String    @map("behavior_policy_hash") @db.VarChar(64)
  safetyPolicyVersion String    @map("safety_policy_version") @db.VarChar(50)
  modelId             String    @map("model_id") @db.VarChar(100)
  memoryIds           Json      @map("memory_ids") @db.JsonB
  relationshipStage   String?   @map("relationship_stage") @db.VarChar(40)
  activeGoalId        String?   @map("active_goal_id") @db.VarChar(100)
  activeTaskId        String?   @map("active_task_id") @db.VarChar(100)
  selectedSkillSlugs  Json      @map("selected_skill_slugs") @db.JsonB
  contextAttribution  Json?     @map("context_attribution") @db.JsonB
  tokensPrompt        Int       @default(0) @map("tokens_prompt")
  tokensCompletion    Int       @default(0) @map("tokens_completion")
