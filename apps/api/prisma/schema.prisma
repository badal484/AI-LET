  id           String            @id @default(uuid()) @db.Uuid
  experimentId String            @map("experiment_id") @db.VarChar(100)
  experiment   Experiment        @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  subjectId    String            @map("subject_id") @db.VarChar(100)
  variantKey   String            @map("variant_key") @db.VarChar(50)
  variant      ExperimentVariant @relation(fields: [experimentId, variantKey], references: [experimentId, key], onDelete: Cascade)
  context      Json?             @db.JsonB
  exposedAt    DateTime          @default(now()) @map("exposed_at") @db.Timestamptz(6)

  @@unique([experimentId, subjectId])
  @@index([subjectId])
  @@map("experiment_exposures")
}

model AnalyticsAlert {
  id                    String    @id @default(uuid()) @db.Uuid
  severity              String    @db.VarChar(20) // 'INFO', 'WARNING', 'CRITICAL'
  category              String    @db.VarChar(50) // 'AI_COST', 'REVENUE', 'ACTIVATION', 'API_ERRORS', 'NOTIFICATIONS', 'SAFETY'
  title                 String    @db.VarChar(200)
  message               String    @db.Text
  metrics               Json?     @db.JsonB
  status                String    @default("OPEN") @db.VarChar(30) // 'OPEN', 'ACKNOWLEDGED', 'RESOLVED'
  acknowledgedByAdminId String?   @map("acknowledged_by_admin_id") @db.Uuid
  resolvedAt            DateTime? @map("resolved_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, severity])
  @@index([category])
  @@map("analytics_alerts")
}

// =============================================================================
// PHASE 24: SOCIAL LAYER
// Public identity, safe social graph, snapshots, comments, messaging,
// communities, moderation cases, AI social capabilities and versioned policy.
// Blocks reuse `UserBlock`; creator follows reuse `CreatorFollow`;
// favorites reuse `UserFavorite`; restrictions reuse `UserRestriction`.
// =============================================================================

enum SocialProfileVisibility {
  PUBLIC
  LIMITED
  PRIVATE
}

enum SocialAudience {
  EVERYONE
  FOLLOWERS
  MUTUALS
  NOBODY
}

enum SocialFollowPolicy {
  EVERYONE
  APPROVAL_REQUIRED
  NOBODY
}

enum SocialFollowStatus {
  ACTIVE
  PENDING
}

enum SocialMuteTargetType {
  USER
  CREATOR
  CHARACTER
  COMMUNITY
  TOPIC
  NOTIFICATION_CATEGORY
}

enum SocialMuteScope {
  ALL
  POSTS
  COMMENTS
  NOTIFICATIONS
}

enum SocialContentKind {
  CHARACTER_SHARE
  CONVERSATION_EXCERPT
  MEDIA_SHARE
  COLLECTION_SHARE
  CREATOR_POST
  CHARACTER_POST
  COMMUNITY_POST
}

enum SocialAuthorType {
  USER
  CREATOR
  AI_CHARACTER
  PLATFORM
}

enum SocialContentVisibility {
  PUBLIC
  UNLISTED
  FOLLOWERS
  COMMUNITY
}

enum SocialContentStatus {
  DRAFT
  PENDING_APPROVAL
  PENDING_MODERATION
  PUBLISHED
  RESTRICTED
  HIDDEN
  REJECTED
  DELETED
  ARCHIVED
}

enum SocialCommentStatus {
  PENDING_MODERATION
  PUBLISHED
  HIDDEN
  REMOVED
  DELETED
}

enum SocialReactionType {
  LIKE
  FAVORITE
  APPRECIATION
  USEFUL
}

enum SocialReportTargetType {
  PROFILE
  CHARACTER
  CONTENT
  COMMENT
  DIRECT_MESSAGE
  COMMUNITY
  CREATOR
}

enum SocialModerationQueue {
  PROFILES
  USER_CONTENT
  COMMENTS
  MESSAGES
  COMMUNITIES
  CREATORS
  AI_SOCIAL_CONTENT
  MEDIA
}

enum SocialCaseStatus {
  OPEN
  IN_REVIEW
  ACTIONED
  DISMISSED
  ESCALATED
}

enum SocialAppealStatus {
  SUBMITTED
  UNDER_REVIEW
  UPHELD
  REVERSED
  EXPIRED
}

enum SocialMessageRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
  EXPIRED
}

enum SocialDirectThreadStatus {
  REQUESTED
  ACTIVE
  CLOSED
}

enum SocialDirectMessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  DELETED
  MODERATED
}

enum CommunityPrivacy {
  PUBLIC
  DISCOVERABLE_PRIVATE
  INVITE_ONLY
}

enum CommunityRole {
  OWNER
  MODERATOR
  MEMBER
}

enum CommunityMemberStatus {
  ACTIVE
  INVITED
  PENDING
  MUTED
  BANNED
  LEFT
}

enum ScheduledSocialActionStatus {
  PENDING_APPROVAL
  ACTIVE
  PAUSED
  CANCELLED
  COMPLETED
}

/// Public social identity. Separate from `UserProfile` so that nothing private is ever
/// serialized by accident. `publicId` is the only identifier exposed to other users.
model SocialProfile {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @unique @map("user_id") @db.Uuid
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  publicId          String    @unique @map("public_id") @db.VarChar(32)
  username          String?   @unique @db.VarChar(30)
  /// Confusable-folded skeleton used for collision / impersonation detection.
  usernameCanonical String?   @unique @map("username_canonical") @db.VarChar(30)
  displayName       String    @map("display_name") @db.VarChar(60)
  bio               String?   @db.VarChar(300)
  avatarUrl         String?   @map("avatar_url") @db.Text
  pronouns          String?   @db.VarChar(30)
  profileTheme      String?   @map("profile_theme") @db.VarChar(30)
  locale            String    @default("en") @db.VarChar(10)
  status            String    @default("ACTIVE") @db.VarChar(20) // ACTIVE, RESTRICTED, HIDDEN
  followersCount    Int       @default(0) @map("followers_count")
  followingCount    Int       @default(0) @map("following_count")
  usernameChangedAt DateTime? @map("username_changed_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status])
  @@index([displayName(ops: raw("gin_trgm_ops"))], type: Gin, map: "social_profiles_display_name_trgm_idx")
  @@index([username(ops: raw("gin_trgm_ops"))], type: Gin, map: "social_profiles_username_trgm_idx")
  @@map("social_profiles")
}

/// Per-feature privacy. Defaults are privacy-first; there is intentionally no single global flag.
model SocialPrivacySettings {
  userId                      String                  @id @map("user_id") @db.Uuid
  user                        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileVisibility           SocialProfileVisibility @default(LIMITED) @map("profile_visibility")
  followPolicy                SocialFollowPolicy      @default(EVERYONE) @map("follow_policy")
  followListAudience          SocialAudience          @default(NOBODY) @map("follow_list_audience")
  creationsAudience           SocialAudience          @default(EVERYONE) @map("creations_audience")
  sharedContentAudience       SocialAudience          @default(EVERYONE) @map("shared_content_audience")
  activityAudience            SocialAudience          @default(NOBODY) @map("activity_audience")
  communitiesAudience         SocialAudience          @default(NOBODY) @map("communities_audience")
  showOnlineStatus            Boolean                 @default(false) @map("show_online_status")
  whoCanMessage               SocialAudience          @default(MUTUALS) @map("who_can_message")
  whoCanMention               SocialAudience          @default(FOLLOWERS) @map("who_can_mention")
  whoCanComment               SocialAudience          @default(EVERYONE) @map("who_can_comment")
  whoCanInviteToCommunities   SocialAudience          @default(MUTUALS) @map("who_can_invite_to_communities")
  discoverable                Boolean                 @default(false)
  searchable                  Boolean                 @default(true)
  socialRecommendations       Boolean                 @default(true) @map("social_recommendations")
  characterSocialInteractions Boolean                 @default(false) @map("character_social_interactions")
  version                     Int                     @default(1)
  createdAt                   DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("social_privacy_settings")
}

model SocialUsernameHistory {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String?   @map("user_id") @db.Uuid
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  action        String    @db.VarChar(20) // CLAIM, CHANGE, RELEASE, ADMIN_RESET
  oldUsername   String?   @map("old_username") @db.VarChar(30)
  newUsername   String?   @map("new_username") @db.VarChar(30)
  /// Old canonical names are held for a period so they cannot be immediately re-registered by impersonators.
  heldCanonical String?   @map("held_canonical") @db.VarChar(30)
  holdUntil     DateTime? @map("hold_until") @db.Timestamptz(6)
  actorAdminId  String?   @map("actor_admin_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt(sort: Desc)])
  @@index([heldCanonical, holdUntil])
  @@map("social_username_history")
}

/// Admin-managed reserved names (brands, staff, verified creators) on top of the static config list.
model SocialReservedUsername {
  canonical String   @id @db.VarChar(30)
  reason    String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("social_reserved_usernames")
}

model UserFollow {
  id             String             @id @default(uuid()) @db.Uuid
  followerUserId String             @map("follower_user_id") @db.Uuid
  follower       User               @relation("FollowFollower", fields: [followerUserId], references: [id], onDelete: Cascade)
  followedUserId String             @map("followed_user_id") @db.Uuid
  followed       User               @relation("FollowFollowed", fields: [followedUserId], references: [id], onDelete: Cascade)
  status         SocialFollowStatus @default(ACTIVE)
  acceptedAt     DateTime?          @map("accepted_at") @db.Timestamptz(6)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([followerUserId, followedUserId])
  @@index([followerUserId, status, createdAt(sort: Desc)])
  @@index([followedUserId, status, createdAt(sort: Desc)])
  @@map("user_follows")
}

/// Following a character is distinct from favoriting it (`UserFavorite`) and from chatting with it.
model CharacterFollow {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  characterId          String    @map("character_id") @db.Uuid
  character            Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  notificationsEnabled Boolean   @default(false) @map("notifications_enabled")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([userId, characterId])
  @@index([characterId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("character_follows")
}

model UserMute {
  id         String               @id @default(uuid()) @db.Uuid
  userId     String               @map("user_id") @db.Uuid
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType SocialMuteTargetType @map("target_type")
  targetId   String               @map("target_id") @db.VarChar(100)
  scope      SocialMuteScope      @default(ALL)
  expiresAt  DateTime?            @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([userId, targetType, targetId, scope])
  @@index([userId, targetType])
  @@map("user_mutes")
}

/// Public/shared object. Always an immutable snapshot: live conversations and private
/// character configuration are never referenced by the public representation.
model SocialContent {
  id                String                  @id @default(uuid()) @db.Uuid
  /// High-entropy opaque token used in share URLs and deep links. Never a DB id.
  publicId          String                  @unique @map("public_id") @db.VarChar(32)
  kind              SocialContentKind
  authorType        SocialAuthorType        @map("author_type")
  authorUserId      String?                 @map("author_user_id") @db.Uuid
  author            User?                   @relation("SocialContentAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  characterId       String?                 @map("character_id") @db.Uuid
  character         Character?              @relation(fields: [characterId], references: [id], onDelete: SetNull)
  communityId       String?                 @map("community_id") @db.Uuid
  community         Community?              @relation(fields: [communityId], references: [id], onDelete: Cascade)
  /// Private back-reference to the source object (never serialized publicly).
  sourceType        String?                 @map("source_type") @db.VarChar(40)
  sourceRef         String?                 @map("source_ref") @db.VarChar(100)
  title             String?                 @db.VarChar(150)
  body              String?                 @db.Text
  snapshot          Json                    @default("{}") @db.JsonB
  visibility        SocialContentVisibility @default(UNLISTED)
  status            SocialContentStatus     @default(DRAFT)
  moderationStatus  String                  @default("PENDING") @map("moderation_status") @db.VarChar(20) // PENDING, APPROVED, FLAGGED, REJECTED
  moderationReasons Json?                   @map("moderation_reasons") @db.JsonB
  redactionReport   Json?                   @map("redaction_report") @db.JsonB
  isAiGenerated     Boolean                 @default(false) @map("is_ai_generated")
  /// generationId, model, characterVersionId, promptVersion, safetyVersion, generatedAt
  aiProvenance      Json?                   @map("ai_provenance") @db.JsonB
  topics            String[]                @default([])
  version           Int                     @default(1)
  reactionCount     Int                     @default(0) @map("reaction_count")
  commentCount      Int                     @default(0) @map("comment_count")
  expiresAt         DateTime?               @map("expires_at") @db.Timestamptz(6)
  revokedAt         DateTime?               @map("revoked_at") @db.Timestamptz(6)
  publishedAt       DateTime?               @map("published_at") @db.Timestamptz(6)
  deletedAt         DateTime?               @map("deleted_at") @db.Timestamptz(6)
  revisions         SocialContentRevision[]
  reactions         SocialReaction[]
  comments          SocialComment[]
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([authorUserId, createdAt(sort: Desc)])
  @@index([characterId, status, publishedAt(sort: Desc)])
  @@index([communityId, status, publishedAt(sort: Desc)])
  @@index([status, publishedAt(sort: Desc)])
  @@index([sourceType, sourceRef])
  @@map("social_contents")
}

model SocialContentRevision {
  id               String        @id @default(uuid()) @db.Uuid
  contentId        String        @map("content_id") @db.Uuid
  content          SocialContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  version          Int
  title            String?       @db.VarChar(150)
  body             String?       @db.Text
  snapshot         Json          @db.JsonB
  editedByUserId   String?       @map("edited_by_user_id") @db.Uuid
  moderationStatus String        @map("moderation_status") @db.VarChar(20)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([contentId, version])
  @@map("social_content_revisions")
}

model SocialReaction {
  id           String             @id @default(uuid()) @db.Uuid
  userId       String             @map("user_id") @db.Uuid
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentId    String             @map("content_id") @db.Uuid
  content      SocialContent      @relation(fields: [contentId], references: [id], onDelete: Cascade)
  reactionType SocialReactionType @map("reaction_type")
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([userId, contentId, reactionType])
  @@index([contentId, reactionType])
  @@map("social_reactions")
}

model SocialComment {
  id                String              @id @default(uuid()) @db.Uuid
  contentId         String              @map("content_id") @db.Uuid
  content           SocialContent       @relation(fields: [contentId], references: [id], onDelete: Cascade)
  authorType        SocialAuthorType    @default(USER) @map("author_type")
  authorUserId      String?             @map("author_user_id") @db.Uuid
  author            User?               @relation("SocialCommentAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  characterId       String?             @map("character_id") @db.Uuid
  parentId          String?             @map("parent_id") @db.Uuid
  parent            SocialComment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies           SocialComment[]     @relation("CommentReplies")
  body              String              @db.VarChar(2000)
  status            SocialCommentStatus @default(PENDING_MODERATION)
  moderationReasons Json?               @map("moderation_reasons") @db.JsonB
  mentionedUserIds  String[]            @default([]) @map("mentioned_user_ids")
  replyCount        Int                 @default(0) @map("reply_count")
  editedAt          DateTime?           @map("edited_at") @db.Timestamptz(6)
  deletedAt         DateTime?           @map("deleted_at") @db.Timestamptz(6)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([contentId, parentId, createdAt])
  @@index([authorUserId, createdAt(sort: Desc)])
  @@map("social_comments")
}

model SocialReport {
  id             String                 @id @default(uuid()) @db.Uuid
  reporterUserId String                 @map("reporter_user_id") @db.Uuid
  reporter       User                   @relation(fields: [reporterUserId], references: [id], onDelete: Cascade)
  targetType     SocialReportTargetType @map("target_type")
  targetId       String                 @map("target_id") @db.VarChar(100)
  reasonCode     String                 @map("reason_code") @db.VarChar(40)
  details        String?                @db.VarChar(1000)
  caseId         String?                @map("case_id") @db.Uuid
  moderationCase SocialModerationCase?  @relation(fields: [caseId], references: [id], onDelete: SetNull)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([reporterUserId, targetType, targetId])
  @@index([targetType, targetId])
  @@map("social_reports")
}

/// One open case per target: reports are aggregated rather than creating duplicate cases.
model SocialModerationCase {
  id                   String                 @id @default(uuid()) @db.Uuid
  targetType           SocialReportTargetType @map("target_type")
  targetId             String                 @map("target_id") @db.VarChar(100)
  /// "{targetType}:{targetId}" while the case is open, NULL once resolved (enforces one open case per target).
  openKey              String?                @unique @map("open_key") @db.VarChar(150)
  subjectUserId        String?                @map("subject_user_id") @db.Uuid
  queue                SocialModerationQueue
  status               SocialCaseStatus       @default(OPEN)
  severity             String                 @default("LOW") @db.VarChar(10) // LOW, MEDIUM, HIGH, CRITICAL
  priorityScore        Float                  @default(0) @map("priority_score")
  reportCount          Int                    @default(0) @map("report_count")
  uniqueReporterCount  Int                    @default(0) @map("unique_reporter_count")
  reasonCounts         Json                   @default("{}") @map("reason_counts") @db.JsonB
  automatedSignals     Json?                  @map("automated_signals") @db.JsonB
  reach                Int                    @default(0)
  /// Content version the case refers to; decisions on a stale version are refused (optimistic concurrency).
  targetVersion        Int?                   @map("target_version")
  /// Social policy version in force when the case was opened / decided (immutable history).
  openedPolicyVersion  Int?                   @map("opened_policy_version")
  decidedPolicyVersion Int?                   @map("decided_policy_version")
  decision             String?                @db.VarChar(40)
  decisionNotes        String?                @map("decision_notes") @db.Text
  moderatorNotes       String?                @map("moderator_notes") @db.Text
  reviewedByAdminId    String?                @map("reviewed_by_admin_id") @db.Uuid
  reviewedAt           DateTime?              @map("reviewed_at") @db.Timestamptz(6)
  firstReportedAt      DateTime?              @map("first_reported_at") @db.Timestamptz(6)
  lastReportedAt       DateTime?              @map("last_reported_at") @db.Timestamptz(6)
  reports              SocialReport[]
  appeals              SocialAppeal[]
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([queue, status, priorityScore(sort: Desc)])
  @@index([targetType, targetId])
  @@index([subjectUserId])
  @@map("social_moderation_cases")
}

/// Append-only record of platform and community moderation actions.
model SocialModerationAction {
  id            String    @id @default(uuid()) @db.Uuid
  scope         String    @db.VarChar(20) // PLATFORM, COMMUNITY
  communityId   String?   @map("community_id") @db.Uuid
  caseId        String?   @map("case_id") @db.Uuid
  actorType     String    @map("actor_type") @db.VarChar(20)
  actorId       String?   @map("actor_id") @db.Uuid
  action        String    @db.VarChar(50)
  targetType    String    @map("target_type") @db.VarChar(30)
  targetId      String    @map("target_id") @db.VarChar(100)
  reason        String?   @db.Text
  notes         String?   @db.Text
  expiresAt     DateTime? @map("expires_at") @db.Timestamptz(6)
  /// State of the target before and after the action, and the social policy version in force.
  previousState String?   @map("previous_state") @db.VarChar(40)
  newState      String?   @map("new_state") @db.VarChar(40)
  policyVersion Int?      @map("policy_version")
  metadata      Json?     @db.JsonB
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([communityId, createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@index([caseId])
  @@map("social_moderation_actions")
}

model SocialAppeal {
  id                String               @id @default(uuid()) @db.Uuid
  userId            String               @map("user_id") @db.Uuid
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  caseId            String               @map("case_id") @db.Uuid
  moderationCase    SocialModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  reason            String               @db.VarChar(2000)
  status            SocialAppealStatus   @default(SUBMITTED)
  decisionNotes     String?              @map("decision_notes") @db.Text
  reviewedByAdminId String?              @map("reviewed_by_admin_id") @db.Uuid
  reviewedAt        DateTime?            @map("reviewed_at") @db.Timestamptz(6)
  expiresAt         DateTime?            @map("expires_at") @db.Timestamptz(6)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, caseId])
  @@index([status, createdAt])
  @@map("social_appeals")
}

/// Human-to-human messaging. Deliberately separate from the AI `Conversation` model.
model SocialDirectThread {
  id            String                    @id @default(uuid()) @db.Uuid
  /// Sorted "{userA}:{userB}" — one thread per pair.
  pairKey       String                    @unique @map("pair_key") @db.VarChar(80)
  status        SocialDirectThreadStatus  @default(REQUESTED)
  lastMessageAt DateTime?                 @map("last_message_at") @db.Timestamptz(6)
  participants  SocialDirectParticipant[]
  messages      SocialDirectMessage[]
  requests      SocialMessageRequest[]
  createdAt     DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("social_direct_threads")
}

model SocialDirectParticipant {
  threadId    String             @map("thread_id") @db.Uuid
  thread      SocialDirectThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId      String             @map("user_id") @db.Uuid
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  unreadCount Int                @default(0) @map("unread_count")
  lastReadAt  DateTime?          @map("last_read_at") @db.Timestamptz(6)
  isArchived  Boolean            @default(false) @map("is_archived")
  joinedAt    DateTime           @default(now()) @map("joined_at") @db.Timestamptz(6)

  @@id([threadId, userId])
  @@index([userId])
  @@map("social_direct_participants")
}

model SocialDirectMessage {
  id               String                    @id @default(uuid()) @db.Uuid
  threadId         String                    @map("thread_id") @db.Uuid
  thread           SocialDirectThread        @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderUserId     String?                   @map("sender_user_id") @db.Uuid
  sender           User?                     @relation("DirectMessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)
  /// Client-generated idempotency key (per sender).
  clientMessageId  String                    @map("client_message_id") @db.VarChar(64)
  body             String                    @db.VarChar(2000)
  /// Attachment metadata only: storage keys are resolved to short-lived signed URLs at read time.
  attachments      Json?                     @db.JsonB
  status           SocialDirectMessageStatus @default(SENT)
  moderationStatus String                    @default("APPROVED") @map("moderation_status") @db.VarChar(20)
  deliveredAt      DateTime?                 @map("delivered_at") @db.Timestamptz(6)
  readAt           DateTime?                 @map("read_at") @db.Timestamptz(6)
  deletedAt        DateTime?                 @map("deleted_at") @db.Timestamptz(6)
  createdAt        DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([senderUserId, clientMessageId])
  @@index([threadId, createdAt(sort: Desc)])
  @@map("social_direct_messages")
}

model SocialMessageRequest {
  id              String                     @id @default(uuid()) @db.Uuid
  senderUserId    String                     @map("sender_user_id") @db.Uuid
  sender          User                       @relation("MessageRequestSender", fields: [senderUserId], references: [id], onDelete: Cascade)
  recipientUserId String                     @map("recipient_user_id") @db.Uuid
  recipient       User                       @relation("MessageRequestRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  threadId        String                     @map("thread_id") @db.Uuid
  thread          SocialDirectThread         @relation(fields: [threadId], references: [id], onDelete: Cascade)
  /// "{sender}:{recipient}" while pending, NULL once resolved (one pending request per direction).
  pendingKey      String?                    @unique @map("pending_key") @db.VarChar(80)
  status          SocialMessageRequestStatus @default(PENDING)
  expiresAt       DateTime                   @map("expires_at") @db.Timestamptz(6)
  respondedAt     DateTime?                  @map("responded_at") @db.Timestamptz(6)
  createdAt       DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([recipientUserId, status, createdAt(sort: Desc)])
  @@index([senderUserId, createdAt(sort: Desc)])
  @@map("social_message_requests")
}

model Community {
  id          String            @id @default(uuid()) @db.Uuid
  slug        String            @unique @db.VarChar(50)
  name        String            @db.VarChar(60)
  description String            @db.VarChar(1000)
  rules       Json              @default("[]") @db.JsonB
  privacy     CommunityPrivacy  @default(PUBLIC)
  status      String            @default("ACTIVE") @db.VarChar(20) // ACTIVE, RESTRICTED, SUSPENDED, ARCHIVED
  ownerUserId String?           @map("owner_user_id") @db.Uuid
  owner       User?             @relation("CommunityOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  characterId String?           @map("character_id") @db.Uuid
  character   Character?        @relation(fields: [characterId], references: [id], onDelete: SetNull)
  memberCount Int               @default(0) @map("member_count")
  members     CommunityMember[]
  posts       SocialContent[]
  deletedAt   DateTime?         @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([privacy, status, memberCount(sort: Desc)])
  @@index([ownerUserId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "communities_name_trgm_idx")
  @@map("communities")
}

model CommunityMember {
  id              String                @id @default(uuid()) @db.Uuid
  communityId     String                @map("community_id") @db.Uuid
  community       Community             @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId          String                @map("user_id") @db.Uuid
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            CommunityRole         @default(MEMBER)
  status          CommunityMemberStatus @default(ACTIVE)
  restrictedUntil DateTime?             @map("restricted_until") @db.Timestamptz(6)
  invitedByUserId String?               @map("invited_by_user_id") @db.Uuid
  rulesAcceptedAt DateTime?             @map("rules_accepted_at") @db.Timestamptz(6)
  joinedAt        DateTime              @default(now()) @map("joined_at") @db.Timestamptz(6)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([communityId, userId])
  @@index([userId, status])
  @@index([communityId, status, role])
  @@map("community_members")
}

/// Creator-configured, platform-approved, versioned social capabilities for a character.
model CharacterSocialCapability {
  characterId                  String    @id @map("character_id") @db.Uuid
  character                    Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  canPublish                   Boolean   @default(false) @map("can_publish")
  canReply                     Boolean   @default(false) @map("can_reply")
  canComment                   Boolean   @default(false) @map("can_comment")
  canReact                     Boolean   @default(false) @map("can_react")
  canSendNotifications         Boolean   @default(false) @map("can_send_notifications")
  canMentionUsers              Boolean   @default(false) @map("can_mention_users")
  /// Stored for completeness; platform policy hard-denies character-initiated DMs regardless.
  canMessageUsers              Boolean   @default(false) @map("can_message_users")
  requiresCreatorApproval      Boolean   @default(true) @map("requires_creator_approval")
  maxPostsPerDay               Int       @default(2) @map("max_posts_per_day")
  maxRepliesPerHour            Int       @default(5) @map("max_replies_per_hour")
  maxInteractionsPerUserPerDay Int       @default(3) @map("max_interactions_per_user_per_day")
  maxDailyCostCents            Int       @default(50) @map("max_daily_cost_cents")
  cooldownSeconds              Int       @default(600) @map("cooldown_seconds")
  platformApproved             Boolean   @default(false) @map("platform_approved")
  platformApprovedByAdminId    String?   @map("platform_approved_by_admin_id") @db.Uuid
  platformApprovedAt           DateTime? @map("platform_approved_at") @db.Timestamptz(6)
  version                      Int       @default(1)
  updatedByUserId              String?   @map("updated_by_user_id") @db.Uuid
  createdAt                    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("character_social_capabilities")
}

/// Every social action decision (human and AI). The idempotency key makes retried AI actions exactly-once.
model SocialActionLog {
  id                 String   @id @default(uuid()) @db.Uuid
  actorType          String   @map("actor_type") @db.VarChar(20) // USER, AI_CHARACTER, ADMIN, SYSTEM, SCHEDULER
  actorId            String?  @map("actor_id") @db.VarChar(100)
  onBehalfOfUserId   String?  @map("on_behalf_of_user_id") @db.Uuid
  characterId        String?  @map("character_id") @db.Uuid
  characterVersionId String?  @map("character_version_id") @db.Uuid
  action             String   @db.VarChar(50)
  targetType         String?  @map("target_type") @db.VarChar(30)
  targetId           String?  @map("target_id") @db.VarChar(100)
  decision           String   @db.VarChar(30)
  /// Lifecycle for actions that wait on a human: PENDING_APPROVAL, EXECUTED, DENIED, REJECTED, CANCELLED.
  status             String?  @db.VarChar(20)
  /// The exact proposal awaiting approval (re-validated in full before execution).
  payload            Json?    @db.JsonB
  reasons            Json     @default("[]") @db.JsonB
  authorization      Json?    @db.JsonB
  consentRef         String?  @map("consent_ref") @db.VarChar(100)
  generationId       String?  @map("generation_id") @db.VarChar(100)
  toolVersion        String?  @map("tool_version") @db.VarChar(30)
  moderationResult   Json?    @map("moderation_result") @db.JsonB
  costCents          Int?     @map("cost_cents")
  requestId          String?  @map("request_id") @db.VarChar(100)
  idempotencyKey     String?  @unique @map("idempotency_key") @db.VarChar(128)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([actorType, actorId, createdAt(sort: Desc)])
  @@index([characterId, action, createdAt(sort: Desc)])
  @@index([characterId, status])
  @@index([action, createdAt(sort: Desc)])
  @@map("social_action_logs")
}

model ScheduledSocialAction {
  id             String                      @id @default(uuid()) @db.Uuid
  ownerUserId    String                      @map("owner_user_id") @db.Uuid
  owner          User                        @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  characterId    String?                     @map("character_id") @db.Uuid
  actionType     String                      @map("action_type") @db.VarChar(40) // CHARACTER_POST, CREATOR_ANNOUNCEMENT
  payload        Json                        @db.JsonB
  intervalHours  Int                         @map("interval_hours")
  nextRunAt      DateTime                    @map("next_run_at") @db.Timestamptz(6)
  lastRunAt      DateTime?                   @map("last_run_at") @db.Timestamptz(6)
  runCount       Int                         @default(0) @map("run_count")
  approvalPolicy String                      @default("CREATOR_APPROVAL") @map("approval_policy") @db.VarChar(30)
  budgetCents    Int                         @default(100) @map("budget_cents")
  spentCents     Int                         @default(0) @map("spent_cents")
  status         ScheduledSocialActionStatus @default(ACTIVE)
  lastError      String?                     @map("last_error") @db.VarChar(500)
  createdAt      DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, nextRunAt])
  @@index([ownerUserId])
  @@map("scheduled_social_actions")
}

/// Versioned, auditable social configuration with rollback. Exactly one row is active.
model SocialPolicyVersion {
  id             String   @id @default(uuid()) @db.Uuid
  version        Int      @unique
  config         Json     @db.JsonB
  diff           Json?    @db.JsonB
  changeReason   String   @map("change_reason") @db.Text
  authorAdminId  String?  @map("author_admin_id") @db.Uuid
  rolledBackFrom Int?     @map("rolled_back_from")
  isActive       Boolean  @default(false) @map("is_active")
  effectiveAt    DateTime @default(now()) @map("effective_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([isActive])
  @@map("social_policy_versions")
}

/// Append-only consent ledger: latest row per (user, consentType) wins.
model SocialConsent {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  consentType   String   @map("consent_type") @db.VarChar(50)
  policyVersion String   @map("policy_version") @db.VarChar(20)
  granted       Boolean
  source        String   @default("SETTINGS") @db.VarChar(30)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, consentType, createdAt(sort: Desc)])
  @@map("social_consents")
}

model SocialFeedFeedback {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  signal     String    @db.VarChar(20) // NOT_INTERESTED, SHOW_LESS, HIDE
  targetType String    @map("target_type") @db.VarChar(20) // CONTENT, AUTHOR, CHARACTER, COMMUNITY, TOPIC
  targetId   String    @map("target_id") @db.VarChar(100)
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([userId, targetType, targetId, signal])
  @@index([userId, createdAt(sort: Desc)])
  @@map("social_feed_feedback")
}

/// Transactional outbox for social domain events. Rows are written in the same transaction as the
/// state change (where the caller provides one) and relayed by a worker, so events survive crashes.
model SocialEventOutbox {
  id           String    @id @default(uuid()) @db.Uuid
  eventName    String    @map("event_name") @db.VarChar(60)
  eventVersion Int       @default(1) @map("event_version")
  actorId      String?   @map("actor_id") @db.Uuid
  targetId     String?   @map("target_id") @db.VarChar(100)
  /// PUBLIC_METADATA | PERSONAL (ids of people) — never raw user-generated text.
  privacy      String    @default("PERSONAL") @db.VarChar(20)
  payload      Json      @db.JsonB
  requestId    String?   @map("request_id") @db.VarChar(100)
  status       String    @default("PENDING") @db.VarChar(20) // PENDING, DISPATCHED, DEAD
  attempts     Int       @default(0)
  availableAt  DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  lastError    String?   @map("last_error") @db.VarChar(1000)
  dispatchedAt DateTime? @map("dispatched_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, availableAt])
  @@index([createdAt])
  @@map("social_event_outbox")
}

/// Consumer-side idempotency: one row per (event, consumer). Duplicate deliveries are no-ops.
model SocialEventReceipt {
  eventId     String   @map("event_id") @db.Uuid
  consumer    String   @db.VarChar(60)
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@id([eventId, consumer])
  @@index([processedAt])
  @@map("social_event_receipts")
}

