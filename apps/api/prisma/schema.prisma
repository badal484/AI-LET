  characterId    String    @map("character_id") @db.VarChar(100)
  skillSlug      String    @map("skill_slug") @db.VarChar(80)
  assignmentType String    @default("default") @map("assignment_type") @db.VarChar(30) // default, optional, premium, creator, disabled
