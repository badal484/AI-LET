/// Creator knowledge ingestion with scanning, chunking, and versioned moderation
model CreatorKnowledgeDoc {
  id               String                  @id @default(uuid()) @db.VarChar(100)
  creatorId        String                  @map("creator_id") @db.VarChar(100)
  characterId      String?                 @map("character_id") @db.VarChar(100)
  title            String                  @db.VarChar(200)
  sourceUrl        String?                 @map("source_url") @db.VarChar(500)
  originalFilename String?                 @map("original_filename") @db.VarChar(255)
  mimeType         String                  @map("mime_type") @db.VarChar(100)
  fileSizeBytes    Int                     @map("file_size_bytes")
  version          Int                     @default(1)
  chunkCount       Int                     @default(0) @map("chunk_count")
  status           String                  @default("READY") @db.VarChar(30) // PENDING, PROCESSING, READY, FAILED, MODERATION_REJECTED
  moderationStatus String                  @default("PASSED") @map("moderation_status") @db.VarChar(30)
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  chunks           CreatorKnowledgeChunk[]

  @@index([creatorId, status])
  @@index([characterId])
  @@map("creator_knowledge_docs")
}

/// Chunked vector search fragments for creator knowledge
model CreatorKnowledgeChunk {
  id          String              @id @default(uuid()) @db.VarChar(100)
  knowledgeId String              @map("knowledge_id") @db.VarChar(100)
  knowledge   CreatorKnowledgeDoc @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)
  chunkIndex  Int                 @map("chunk_index")
  content     String              @db.Text
  tokenCount  Int                 @default(0) @map("token_count")
  metadata    Json?               @db.JsonB
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([knowledgeId, chunkIndex])
  @@map("creator_knowledge_chunks")
}

// ---------------------------------------------------------------------------
// Phase 26: Production Knowledge, RAG, Web Research & Grounded Citations
// ---------------------------------------------------------------------------

/// Phase 26: Unified Knowledge Document
model KnowledgeDocument {
  id               String                      @id @default(uuid()) @db.VarChar(100)
  ownerId          String                      @map("owner_id") @db.VarChar(100)
  ownerType        String                      @default("USER") @map("owner_type") @db.VarChar(30) // USER, CREATOR, PLATFORM
  characterId      String?                     @map("character_id") @db.VarChar(100)
  title            String                      @db.VarChar(255)
  originalFilename String                      @map("original_filename") @db.VarChar(255)
  mimeType         String                      @map("mime_type") @db.VarChar(100)
  fileSizeBytes    Int                         @map("file_size_bytes")
  storageUrl       String?                     @map("storage_url") @db.VarChar(500)
  contentHash      String                      @map("content_hash") @db.VarChar(64)
  status           String                      @default("UPLOADED") @db.VarChar(30) // UPLOADED, PROCESSING, INDEXED, FAILED, RESTRICTED, DELETED
  failureReason    String?                     @map("failure_reason") @db.Text
  currentVersion   Int                         @default(1) @map("current_version")
  totalChunks      Int                         @default(0) @map("total_chunks")
  totalTokens      Int                         @default(0) @map("total_tokens")
  pageCount        Int                         @default(1) @map("page_count")
  visibility       String                      @default("PRIVATE") @db.VarChar(30) // PRIVATE, SHARED, CHARACTER_ACCESSIBLE, TASK_ONLY, PUBLIC
  createdAt        DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)

  versions         DocumentVersion[]
  chunks           DocumentChunk[]
  collectionLinks  KnowledgeCollectionMember[]

  @@index([ownerId, status])
  @@index([characterId])
  @@index([contentHash])
  @@map("knowledge_documents")
}

/// Immutable document versions
model DocumentVersion {
  id            String            @id @default(uuid()) @db.VarChar(100)
  documentId    String            @map("document_id") @db.VarChar(100)
  document      KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber Int               @map("version_number")
  contentHash   String            @map("content_hash") @db.VarChar(64)
  chunkCount    Int               @default(0) @map("chunk_count")
  tokenCount    Int               @default(0) @map("token_count")
  status        String            @default("ACTIVE") @db.VarChar(30)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  chunks        DocumentChunk[]

  @@unique([documentId, versionNumber])
  @@map("document_versions")
}

/// Chunked fragments for semantic & lexical hybrid search
model DocumentChunk {
  id             String            @id @default(uuid()) @db.VarChar(100)
  documentId     String            @map("document_id") @db.VarChar(100)
  document       KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionId      String?           @map("version_id") @db.VarChar(100)
  version        DocumentVersion?  @relation(fields: [versionId], references: [id], onDelete: SetNull)
  chunkIndex     Int               @map("chunk_index")
  content        String            @db.Text
  pageNumber     Int?              @map("page_number")
  sectionHeading String?           @map("section_heading") @db.VarChar(255)
  sourceOffset   Int?              @map("source_offset")
  tokenCount     Int               @default(0) @map("token_count")
  contentHash    String            @map("content_hash") @db.VarChar(64)
  embedding      Json?             @db.JsonB
  metadata       Json?             @db.JsonB
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([documentId, chunkIndex])
  @@index([contentHash])
  @@map("document_chunks")
}

/// Personal and shared knowledge collections
model KnowledgeCollection {
  id          String                      @id @default(uuid()) @db.VarChar(100)
  ownerId     String                      @map("owner_id") @db.VarChar(100)
  name        String                      @db.VarChar(100)
  description String?                     @db.Text
  visibility  String                      @default("PRIVATE") @db.VarChar(30) // PRIVATE, SHARED, CHARACTER_ACCESSIBLE, TASK_ONLY
  createdAt   DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)

  members     KnowledgeCollectionMember[]

  @@index([ownerId])
  @@map("knowledge_collections")
}

/// Member documents within a collection
model KnowledgeCollectionMember {
  id           String              @id @default(uuid()) @db.VarChar(100)
  collectionId String              @map("collection_id") @db.VarChar(100)
  collection   KnowledgeCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  documentId   String              @map("document_id") @db.VarChar(100)
  document     KnowledgeDocument   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  addedAt      DateTime            @default(now()) @map("added_at") @db.Timestamptz(6)

  @@unique([collectionId, documentId])
  @@map("knowledge_collection_members")
}

/// Web research task orchestrating multi-source search & synthesis
model WebResearchTask {
  id              String            @id @default(uuid()) @db.VarChar(100)
  userId          String            @map("user_id") @db.VarChar(100)
  conversationId  String?           @map("conversation_id") @db.VarChar(100)
  query           String            @db.Text
  status          String            @default("INITIATED") @db.VarChar(30)
  freshnessPolicy String            @default("DAILY") @map("freshness_policy") @db.VarChar(30)
  sourceCount     Int               @default(0) @map("source_count")
  costUsd         Float             @default(0.0) @map("cost_usd")
  summary         String?           @db.Text
  findings        Json?             @db.JsonB
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt     DateTime?         @map("completed_at") @db.Timestamptz(6)

  sources         WebSourceRecord[]

  @@index([userId, status])
  @@index([conversationId])
  @@map("web_research_tasks")
}

/// Web source record with credibility and freshness metadata
model WebSourceRecord {
  id               String           @id @default(uuid()) @db.VarChar(100)
  researchTaskId   String?          @map("research_task_id") @db.VarChar(100)
  researchTask     WebResearchTask? @relation(fields: [researchTaskId], references: [id], onDelete: Cascade)
  url              String           @db.VarChar(1000)
  domain           String           @db.VarChar(255)
  title            String           @db.VarChar(500)
  publisher        String?          @db.VarChar(255)
  contentSnippet   String           @map("content_snippet") @db.Text
  contentHash      String           @map("content_hash") @db.VarChar(64)
  publishedAt      DateTime?        @map("published_at") @db.Timestamptz(6)
  retrievedAt      DateTime         @default(now()) @map("retrieved_at") @db.Timestamptz(6)
  credibilityScore Float?           @map("credibility_score")
  isAccessible     Boolean          @default(true) @map("is_accessible")

  @@index([researchTaskId])
  @@index([domain])
  @@index([url])
  @@map("web_sources")
}

/// Structured citations linking assertions directly to documents or web sources
model CitationRecord {
  id             String    @id @default(uuid()) @db.VarChar(100)
  messageId      String?   @map("message_id") @db.VarChar(100)
  generationId   String?   @map("generation_id") @db.VarChar(100)
  sourceType     String    @map("source_type") @db.VarChar(40) // DOCUMENT, WEB, CREATOR_KNOWLEDGE, EXTERNAL
  documentId     String?   @map("document_id") @db.VarChar(100)
  chunkId        String?   @map("chunk_id") @db.VarChar(100)
  webSourceId    String?   @map("web_source_id") @db.VarChar(100)
  url            String?   @db.VarChar(1000)
  title          String    @db.VarChar(500)
  pageNumber     Int?      @map("page_number")
  sectionHeading String?   @map("section_heading") @db.VarChar(255)
  exactQuote     String?   @map("exact_quote") @db.Text
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([messageId])
  @@index([documentId])
  @@index([chunkId])
  @@map("citation_records")
}

// =============================================================================
// PHASE 27: CHARACTER SIMULATION, PERSISTENT GOALS, ROUTINES & CONTINUITY
// =============================================================================

/// Persistent character objectives and long-horizon goals
model CharacterGoal {
  id                  String             @id @default(uuid()) @db.VarChar(100)
  characterId         String             @map("character_id") @db.VarChar(100)
  characterVersionId  String?            @map("character_version_id") @db.VarChar(100)
  userId              String             @map("user_id") @db.VarChar(100)
  owner               String             @default("CHARACTER") @db.VarChar(30) // CHARACTER, USER, SHARED, SYSTEM
  category            String             @db.VarChar(60) // learning, topic_continuity, habit, narrative_arc, creative, check_in
  title               String             @db.VarChar(255)
  description         String?            @db.Text
  priority            Int                @default(1)
  status              String             @default("ACTIVE") @db.VarChar(30) // DRAFT, ACTIVE, IN_PROGRESS, PAUSED, BLOCKED, COMPLETED, ABANDONED, EXPIRED, CANCELLED
  progress            Float              @default(0.0)
  progressType        String             @default("PERCENTAGE") @map("progress_type") @db.VarChar(30) // BINARY, PERCENTAGE, COUNT, MILESTONE, QUALITATIVE
  qualitativeProgress String?            @map("qualitative_progress") @db.VarChar(30) // NOT_STARTED, EARLY, DEVELOPING, ADVANCED, NEAR_COMPLETE, COMPLETE
  startAt             DateTime           @default(now()) @map("start_at") @db.Timestamptz(6)
  dueAt               DateTime?          @map("due_at") @db.Timestamptz(6)
  lastProgressAt      DateTime?          @map("last_progress_at") @db.Timestamptz(6)
  completedAt         DateTime?          @map("completed_at") @db.Timestamptz(6)
  abandonedAt         DateTime?          @map("abandoned_at") @db.Timestamptz(6)
  source              String?            @db.VarChar(50) // conversation, creator_preset, user_request, routine
  confidence          Float              @default(1.0)
  version             Int                @default(1)
  constraints         Json?              @db.JsonB
  metadata            Json?              @db.JsonB
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  milestones          CharacterGoalMilestone[]
  tasks               CharacterGoalTask[]
  plans               CharacterPlan[]

  @@index([userId, characterId, status])
  @@index([characterId, status])
  @@index([dueAt])
  @@map("character_goals")
}

/// Structured milestones within a character goal (max depth: goal -> milestone -> task)
model CharacterGoalMilestone {
  id          String        @id @default(uuid()) @db.VarChar(100)
  goalId      String        @map("goal_id") @db.VarChar(100)
  goal        CharacterGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  title       String        @db.VarChar(255)
  orderIndex  Int           @default(0) @map("order_index")
  status      String        @default("PENDING") @db.VarChar(30) // PENDING, IN_PROGRESS, COMPLETED, SKIPPED
  completedAt DateTime?     @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  tasks       CharacterGoalTask[]

  @@index([goalId, orderIndex])
  @@map("character_goal_milestones")
}

/// Actionable tasks associated with a character goal or milestone
model CharacterGoalTask {
  id          String                  @id @default(uuid()) @db.VarChar(100)
  goalId      String                  @map("goal_id") @db.VarChar(100)
  goal        CharacterGoal           @relation(fields: [goalId], references: [id], onDelete: Cascade)
  milestoneId String?                 @map("milestone_id") @db.VarChar(100)
  milestone   CharacterGoalMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  title       String                  @db.VarChar(255)
  description String?                 @db.Text
  assignedTo  String                  @default("CHARACTER") @map("assigned_to") @db.VarChar(30) // CHARACTER, USER, SHARED
  status      String                  @default("PENDING") @db.VarChar(30) // PENDING, IN_PROGRESS, COMPLETED, CANCELLED
  completedAt DateTime?               @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([goalId, status])
  @@index([milestoneId])
  @@map("character_goal_tasks")
}

/// Character routines defining recurring behavioral rituals and check-ins
model CharacterRoutine {
  id                   String    @id @default(uuid()) @db.VarChar(100)
  characterId          String    @map("character_id") @db.VarChar(100)
  characterVersionId   String?   @map("character_version_id") @db.VarChar(100)
  name                 String    @db.VarChar(150)
  description          String?   @db.Text
  routineType          String    @map("routine_type") @db.VarChar(40) // TIME_BASED, EVENT_BASED, CONVERSATION_BASED, RELATIONSHIP_BASED, GOAL_BASED, CONTEXT_BASED
  scheduleCron         String?   @map("schedule_cron") @db.VarChar(100)
  timezonePolicy       String    @default("USER_LOCAL_OR_UTC") @map("timezone_policy") @db.VarChar(50)
  frequencyLimitPerDay Int       @default(1) @map("frequency_limit_per_day")
  cooldownMinutes      Int       @default(60) @map("cooldown_minutes")
  quietHoursStart      String?   @map("quiet_hours_start") @db.VarChar(10) // "22:00"
  quietHoursEnd        String?   @map("quiet_hours_end") @db.VarChar(10)   // "08:00"
  priority             Int       @default(1)
  active               Boolean   @default(true)
  constraints          Json?     @db.JsonB
  lastTriggeredAt      DateTime? @map("last_triggered_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([characterId, active])
  @@map("character_routines")
}

/// Open, unresolved conversational threads to follow up on
model OpenConversationalThread {
  id              String    @id @default(uuid()) @db.VarChar(100)
  userId          String    @map("user_id") @db.VarChar(100)
  characterId     String    @map("character_id") @db.VarChar(100)
  conversationId  String?   @map("conversation_id") @db.VarChar(100)
  topic           String    @db.VarChar(200)
  contextSnippet  String?   @map("context_snippet") @db.Text
  status          String    @default("OPEN") @db.VarChar(30) // OPEN, WAITING_FOR_USER, WAITING_FOR_SYSTEM, RESOLVED, EXPIRED, DISMISSED
  priority        Float     @default(0.5)
  sourceMessageId String?   @map("source_message_id") @db.VarChar(100)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId, characterId, status])
  @@index([expiresAt])
  @@map("open_conversational_threads")
}

/// Explicit commitments made by the character or agreed with user
model CharacterCommitment {
  id              String    @id @default(uuid()) @db.VarChar(100)
  userId          String    @map("user_id") @db.VarChar(100)
  characterId     String    @map("character_id") @db.VarChar(100)
  conversationId  String?   @map("conversation_id") @db.VarChar(100)
  commitmentType  String    @map("commitment_type") @db.VarChar(40) // FOLLOW_UP, INQUIRE, REMIND, SHARE_RESOURCE, TOPIC_EXPLORATION
  description     String    @db.Text
  sourceMessageId String?   @map("source_message_id") @db.VarChar(100)
  status          String    @default("PENDING") @db.VarChar(30) // PENDING, FULFILLED, EXPIRED, CANCELLED
  maxAttempts     Int       @default(3) @map("max_attempts")
  attemptsMade    Int       @default(0) @map("attempts_made")
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  fulfilledAt     DateTime? @map("fulfilled_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId, characterId, status])
  @@index([expiresAt])
  @@map("character_commitments")
}

/// Mutable, non-memory internal simulation state per user-character pair
model CharacterSimulationState {
  id                       String    @id @default(uuid()) @db.VarChar(100)
  userId                   String    @map("user_id") @db.VarChar(100)
  characterId              String    @map("character_id") @db.VarChar(100)
  version                  Int       @default(1) // Optimistic concurrency version
  currentFocus             String?   @map("current_focus") @db.VarChar(200)
  behaviorMode             String    @default("supportive") @map("behavior_mode") @db.VarChar(40) // curious, supportive, playful, reflective, focused, quiet, energetic
  behaviorReason           String?   @map("behavior_reason") @db.Text
  behaviorExpiresAt        DateTime? @map("behavior_expires_at") @db.Timestamptz(6)
  initiativeLevel          String    @default("BALANCED") @map("initiative_level") @db.VarChar(30) // OFF, LOW, BALANCED, HIGH
  lastSimulationAt         DateTime? @map("last_simulation_at") @db.Timestamptz(6)
  nextEligibleSimulationAt DateTime? @map("next_eligible_simulation_at") @db.Timestamptz(6)
  metadata                 Json?     @db.JsonB
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, characterId])
  @@map("character_simulation_states")
}

/// Durable audit record for every simulation cycle execution
model SimulationRunRecord {
  id                     String    @id @default(uuid()) @db.VarChar(100)
  userId                 String    @map("user_id") @db.VarChar(100)
  characterId            String    @map("character_id") @db.VarChar(100)
  characterVersionId     String?   @map("character_version_id") @db.VarChar(100)
  triggerType            String    @map("trigger_type") @db.VarChar(40) // CONVERSATION, ROUTINE, GOAL_EVENT, MANUAL, RELATIONSHIP
  triggerEventId         String?   @map("trigger_event_id") @db.VarChar(100)
  status                 String    @default("RUNNING") @db.VarChar(30) // RUNNING, COMPLETED, NO_ACTION, FAILED
  modelId                String?   @map("model_id") @db.VarChar(100)
  promptVersion          String?   @map("prompt_version") @db.VarChar(50)
  contextHash            String?   @map("context_hash") @db.VarChar(64)
  outputHash             String?   @map("output_hash") @db.VarChar(64)
  proposalsCount         Int       @default(0) @map("proposals_count")
  acceptedProposalsCount Int       @default(0) @map("accepted_proposals_count")
  costUsd                Float     @default(0.0) @map("cost_usd")
  latencyMs              Int       @default(0) @map("latency_ms")
  errorCode              String?   @map("error_code") @db.VarChar(60)
  errorMessage           String?   @map("error_message") @db.Text
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  snapshots              SimulationStateSnapshot[]

  @@index([userId, characterId, createdAt(sort: Desc)])
  @@index([status])
  @@map("simulation_run_records")
}

/// Immutable simulation state snapshot for auditing and reproducibility
model SimulationStateSnapshot {
  id              String              @id @default(uuid()) @db.VarChar(100)
  simulationRunId String              @map("simulation_run_id") @db.VarChar(100)
  simulationRun   SimulationRunRecord @relation(fields: [simulationRunId], references: [id], onDelete: Cascade)
  userId          String              @map("user_id") @db.VarChar(100)
  characterId     String              @map("character_id") @db.VarChar(100)
  stateHash       String              @map("state_hash") @db.VarChar(64)
  activeGoalIds   Json                @map("active_goal_ids") @db.JsonB
  openThreadIds   Json                @map("open_thread_ids") @db.JsonB
  commitmentIds   Json                @map("commitment_ids") @db.JsonB
  behaviorMode    String              @map("behavior_mode") @db.VarChar(40)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([simulationRunId])
  @@index([userId, characterId])
  @@map("simulation_state_snapshots")
}

/// Versioned character simulation governance policy
model CharacterSimulationPolicy {
  id                           String   @id @default(uuid()) @db.VarChar(100)
  policyVersion                String   @unique @map("policy_version") @db.VarChar(50)
  status                       String   @default("PUBLISHED") @db.VarChar(30) // DRAFT, REVIEW, PUBLISHED, ARCHIVED
  initiativeLevel              String   @default("BALANCED") @map("initiative_level") @db.VarChar(30)
  maxSimulationsPerUserDay     Int      @default(5) @map("max_simulations_per_user_day")
  maxProactiveCandidatesPerDay Int      @default(2) @map("max_proactive_candidates_per_day")
  maxActiveGoalsPerUser        Int      @default(5) @map("max_active_goals_per_user")
  maxOpenThreadsPerUser        Int      @default(10) @map("max_open_threads_per_user")
  maxActiveCommitmentsPerUser  Int      @default(5) @map("max_active_commitments_per_user")
  proposalsAllowed             Json     @map("proposals_allowed") @db.JsonB
  safetySettings               Json?    @map("safety_settings") @db.JsonB
  createdAt                    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("character_simulation_policies")
}

/// Long-horizon sequential plans linked to character goals or independent workflows
model CharacterPlan {
  id                 String              @id @default(uuid()) @db.VarChar(100)
  characterId        String              @map("character_id") @db.VarChar(100)
  userId             String              @map("user_id") @db.VarChar(100)
  characterVersionId String?             @map("character_version_id") @db.VarChar(100)
  goalId             String?             @map("goal_id") @db.VarChar(100)
  goal               CharacterGoal?      @relation(fields: [goalId], references: [id], onDelete: SetNull)
  title              String              @db.VarChar(255)
  description        String?             @db.Text
  status             String              @default("ACTIVE") @db.VarChar(30) // DRAFT, ACTIVE, PAUSED, BLOCKED, COMPLETED, FAILED, CANCELLED, EXPIRED
  currentStepIndex   Int                 @default(0) @map("current_step_index")
  version            Int                 @default(1)
  expiresAt          DateTime?           @map("expires_at") @db.Timestamptz(6)
  completedAt        DateTime?           @map("completed_at") @db.Timestamptz(6)
  metadata           Json?               @db.JsonB
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  steps              CharacterPlanStep[]

  @@index([userId, characterId, status])
  @@index([characterId, status])
  @@index([goalId])
  @@map("character_plans")
}

/// Actionable sequential steps within a character plan with dependencies
model CharacterPlanStep {
  id                 String        @id @default(uuid()) @db.VarChar(100)
  planId             String        @map("plan_id") @db.VarChar(100)
  plan               CharacterPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  sequence           Int           @default(0)
  title              String        @db.VarChar(255)
  description        String?       @db.Text
  status             String        @default("PENDING") @db.VarChar(30) // PENDING, IN_PROGRESS, COMPLETED, FAILED, SKIPPED
  dependencies       Json?         @db.JsonB
  completionCriteria String?       @map("completion_criteria") @db.Text
  estimatedEffort    String?       @map("estimated_effort") @db.VarChar(50)
  output             Json?         @db.JsonB
  completedAt        DateTime?     @map("completed_at") @db.Timestamptz(6)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([planId, sequence])
  @@map("character_plan_steps")
}

/// Persistent fictional/contextual world state entity (global or user-scoped)
model CharacterWorldState {
  id                 String    @id @default(uuid()) @db.VarChar(100)
  characterId        String    @map("character_id") @db.VarChar(100)
  userId             String?   @map("user_id") @db.VarChar(100) // Null for character-global
  characterVersionId String?   @map("character_version_id") @db.VarChar(100)
  entityKey          String    @map("entity_key") @db.VarChar(100)
  entityType         String    @map("entity_type") @db.VarChar(50) // SETTING, STORY_ARC, ACTIVE_PROJECT, FACTION, ITEM, CUSTOM
  stateValue         Json      @map("state_value") @db.JsonB
  version            Int       @default(1)
  lastEventId        String?   @map("last_event_id") @db.VarChar(100)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([characterId, userId, entityKey])
  @@index([characterId, entityType])
  @@map("character_world_states")
}

/// Immutable event log for world state mutations
model CharacterWorldStateEvent {
  id                 String    @id @default(uuid()) @db.VarChar(100)
  characterId        String    @map("character_id") @db.VarChar(100)
  userId             String?   @map("user_id") @db.VarChar(100)
  characterVersionId String?   @map("character_version_id") @db.VarChar(100)
  eventType          String    @map("event_type") @db.VarChar(60) // PROJECT_STARTED, LOCATION_CHANGED, etc.
  entityKey          String    @map("entity_key") @db.VarChar(100)
  delta              Json      @db.JsonB
  source             String    @db.VarChar(50)
  version            Int       @default(1)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([characterId, entityKey, createdAt(sort: Desc)])
  @@map("character_world_state_events")
}

/// Immutable ledger of all simulation events for event sourcing, replay, and idempotency
model CharacterSimulationEvent {
  id                 String    @id @default(uuid()) @db.VarChar(100)
  characterId        String    @map("character_id") @db.VarChar(100)
  userId             String?   @map("user_id") @db.VarChar(100)
  characterVersionId String?   @map("character_version_id") @db.VarChar(100)
  eventType          String    @map("event_type") @db.VarChar(60)
  source             String    @db.VarChar(50)
  payload            Json      @db.JsonB
  stateVersion       Int       @default(1) @map("state_version")
  correlationId      String?   @map("correlation_id") @db.VarChar(100)
  idempotencyKey     String?   @unique @map("idempotency_key") @db.VarChar(100)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([characterId, userId, createdAt(sort: Desc)])
  @@index([correlationId])
  @@map("character_simulation_events")
}

/// User-controlled simulation preferences and autonomy levels per user-character pair
model UserSimulationSettings {
  id                 String    @id @default(uuid()) @db.VarChar(100)
  userId             String    @map("user_id") @db.VarChar(100)
  characterId        String    @map("character_id") @db.VarChar(100)
  enabled            Boolean   @default(true)
  autonomyLevel      String    @default("CONTEXTUAL") @map("autonomy_level") @db.VarChar(30) // PASSIVE, CONTEXTUAL, PROACTIVE, TASK_ORIENTED
  proactiveEnabled   Boolean   @default(true) @map("proactive_enabled")
  routinesEnabled    Boolean   @default(true) @map("routines_enabled")
  remindersEnabled   Boolean   @default(true) @map("reminders_enabled")
  plansEnabled       Boolean   @default(true) @map("plans_enabled")
  quietHoursStart    String    @default("22:00") @map("quiet_hours_start") @db.VarChar(10)
  quietHoursEnd      String    @default("08:00") @map("quiet_hours_end") @db.VarChar(10)
  userTimezone       String    @default("UTC") @map("user_timezone") @db.VarChar(50)
  metadata           Json?     @db.JsonB
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, characterId])
  @@map("user_simulation_settings")
}

// =============================================================================
// PHASE 28: DEVELOPER PLATFORM, PUBLIC APIS, SDK, OAUTH & WEBHOOKS
// =============================================================================

/// Organization entity for developer teams and enterprise billing
model DeveloperOrganization {
  id                    String                @id @default(uuid()) @db.VarChar(100)
  name                  String                @db.VarChar(100)
  slug                  String                @unique @db.VarChar(100)
  billingEmail          String                @map("billing_email") @db.VarChar(255)
  tier                  String                @default("FREE") @db.VarChar(30) // FREE, BUILDER, SCALE, ENTERPRISE
  monthlyBudgetUsd      Float?                @map("monthly_budget_usd")
  spendAlertThresholds  Json                  @default("[50, 75, 90, 100]") @map("spend_alert_thresholds") @db.JsonB
  hardLimitEnabled      Boolean               @default(true) @map("hard_limit_enabled")
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  members               DeveloperOrgMember[]
  projects              DeveloperProject[]

  @@map("developer_organizations")
}

/// Member association within a DeveloperOrganization with explicit RBAC
model DeveloperOrgMember {
  id              String                @id @default(uuid()) @db.VarChar(100)
  organizationId  String                @map("organization_id") @db.VarChar(100)
  organization    DeveloperOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId          String                @map("user_id") @db.VarChar(100)
  role            String                @default("DEVELOPER") @db.VarChar(30) // OWNER, ADMIN, DEVELOPER, BILLING, ANALYST, READ_ONLY
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("developer_org_members")
}

/// Developer workspace project grouping credentials, webhooks, usage, and environments
model DeveloperProject {
  id               String                 @id @default(uuid()) @db.VarChar(100)
  organizationId   String?                @map("organization_id") @db.VarChar(100)
  organization     DeveloperOrganization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId           String                 @map("user_id") @db.VarChar(100)
  name             String                 @db.VarChar(100)
  slug             String                 @db.VarChar(100)
  status           String                 @default("ACTIVE") @db.VarChar(30) // ACTIVE, RESTRICTED, SUSPENDED
  environment      String                 @default("DEVELOPMENT") @db.VarChar(30) // DEVELOPMENT, STAGING, PRODUCTION
  allowedOrigins   Json                   @default("[]") @map("allowed_origins") @db.JsonB
  metadata         Json?                  @db.JsonB
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  apiKeys          DeveloperApiKey[]
  oauthApps        OAuthApplication[]
  webhooks         WebhookEndpoint[]
  usageRecords     DeveloperUsageRecord[]
  embedConfigs     DeveloperEmbedConfig[]

  @@unique([userId, slug])
  @@index([organizationId])
  @@index([userId])
  @@map("developer_projects")
}

/// Scoped API keys with SHA-256 secret hashing and environment isolation
model DeveloperApiKey {
  id          String           @id @default(uuid()) @db.VarChar(100)
  projectId   String           @map("project_id") @db.VarChar(100)
  project     DeveloperProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String           @db.VarChar(100)
  keyPrefix   String           @map("key_prefix") @db.VarChar(30)
  keyHash     String           @unique @map("key_hash") @db.VarChar(64)
  keyType     String           @default("SERVER") @map("key_type") @db.VarChar(20) // PUBLIC, SERVER, ADMIN
  scopes      Json             @map("scopes") @db.JsonB
  environment String           @default("DEVELOPMENT") @db.VarChar(30)
  lastUsedAt  DateTime?        @map("last_used_at") @db.Timestamptz(6)
  expiresAt   DateTime?        @map("expires_at") @db.Timestamptz(6)
  revokedAt   DateTime?        @map("revoked_at") @db.Timestamptz(6)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([projectId, revokedAt])
  @@index([keyPrefix])
  @@map("developer_api_keys")
}

/// OAuth 2.0 application registration supporting PKCE and confidential clients
model OAuthApplication {
  id                 String           @id @default(uuid()) @db.VarChar(100)
  projectId          String           @map("project_id") @db.VarChar(100)
  project            DeveloperProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name               String           @db.VarChar(100)
  clientId           String           @unique @map("client_id") @db.VarChar(100)
  clientSecretHash   String?          @map("client_secret_hash") @db.VarChar(128)
  redirectUris       Json             @map("redirect_uris") @db.JsonB
  allowedScopes      Json             @map("allowed_scopes") @db.JsonB
  isPublicClient     Boolean          @default(false) @map("is_public_client")
  clientType         String           @default("WEB") @map("client_type") @db.VarChar(30)
  logoUrl            String?          @map("logo_url") @db.VarChar(500)
  privacyPolicyUrl   String?          @map("privacy_policy_url") @db.VarChar(500)
  termsUrl           String?          @map("terms_url") @db.VarChar(500)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  consents           OAuthConsent[]
  tokens             OAuthToken[]

  @@index([projectId])
  @@map("oauth_applications")
}

/// User consent grant for third-party OAuth application
model OAuthConsent {
  id            String           @id @default(uuid()) @db.VarChar(100)
  applicationId String           @map("application_id") @db.VarChar(100)
  application   OAuthApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  userId        String           @map("user_id") @db.VarChar(100)
  grantedScopes Json             @map("granted_scopes") @db.JsonB
  consentedAt   DateTime         @default(now()) @map("consented_at") @db.Timestamptz(6)
  revokedAt     DateTime?        @map("revoked_at") @db.Timestamptz(6)

  @@unique([applicationId, userId])
  @@index([userId])
  @@map("oauth_consents")
}

/// Issued OAuth access and refresh tokens
model OAuthToken {
  id               String           @id @default(uuid()) @db.VarChar(100)
  applicationId    String           @map("application_id") @db.VarChar(100)
  application      OAuthApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  userId           String           @map("user_id") @db.VarChar(100)
  accessTokenHash  String           @unique @map("access_token_hash") @db.VarChar(64)
  refreshTokenHash String?          @unique @map("refresh_token_hash") @db.VarChar(64)
  scopes           Json             @map("scopes") @db.JsonB
  expiresAt        DateTime         @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime?        @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, applicationId])
  @@map("oauth_tokens")
}

/// Registered webhook destination with HMAC signing secret
model WebhookEndpoint {
  id           String            @id @default(uuid()) @db.VarChar(100)
  projectId    String            @map("project_id") @db.VarChar(100)
  project      DeveloperProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url          String            @db.VarChar(500)
  secret       String            @db.VarChar(128)
  description  String?           @db.VarChar(255)
  eventTypes   Json              @map("event_types") @db.JsonB
  environment  String            @default("DEVELOPMENT") @db.VarChar(30)
  active       Boolean           @default(true)
  failureCount Int               @default(0) @map("failure_count")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  deliveries   WebhookDelivery[]

  @@index([projectId, active])
  @@map("webhook_endpoints")
}

/// Webhook delivery attempt record with retry scheduling and DLQ support
model WebhookDelivery {
  id            String          @id @default(uuid()) @db.VarChar(100)
  endpointId    String          @map("endpoint_id") @db.VarChar(100)
  endpoint      WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  eventId       String          @map("event_id") @db.VarChar(100)
  eventType     String          @map("event_type") @db.VarChar(80)
  payload       Json            @db.JsonB
  status        String          @default("PENDING") @db.VarChar(30) // PENDING, DELIVERING, DELIVERED, RETRYING, FAILED, EXPIRED
  statusCode    Int?            @map("status_code")
  responseBody  String?         @map("response_body") @db.Text
  durationMs    Int?            @map("duration_ms")
  attemptNumber Int             @default(1) @map("attempt_number")
  nextRetryAt   DateTime?       @map("next_retry_at") @db.Timestamptz(6)
  deliveredAt   DateTime?       @map("delivered_at") @db.Timestamptz(6)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([endpointId, status])
  @@index([eventId])
  @@index([nextRetryAt])
  @@map("webhook_deliveries")
}

/// Metered billable usage records per project and capability
model DeveloperUsageRecord {
  id             String           @id @default(uuid()) @db.VarChar(100)
  projectId      String           @map("project_id") @db.VarChar(100)
  project        DeveloperProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  metric         String           @db.VarChar(50) // API_REQUESTS, AI_TOKENS, VOICE_SECONDS, IMAGES, AGENT_STEPS, WEB_RESEARCH
  quantity       Float            @default(1)
  costUsd        Float            @default(0.0) @map("cost_usd")
  modelId        String?          @map("model_id") @db.VarChar(60)
  endpoint       String?          @db.VarChar(120)
  environment    String           @default("DEVELOPMENT") @db.VarChar(30)
  idempotencyKey String?          @unique @map("idempotency_key") @db.VarChar(128)
  timestamp      DateTime         @default(now()) @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([projectId, metric, timestamp(sort: Desc)])
  @@map("developer_usage_records")
}

/// Embed configuration for web iframe & widget distribution
model DeveloperEmbedConfig {
  id              String           @id @default(uuid()) @db.VarChar(100)
  projectId       String           @map("project_id") @db.VarChar(100)
  project         DeveloperProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  characterId     String           @map("character_id") @db.VarChar(100)
  originAllowlist Json             @map("origin_allowlist") @db.JsonB
  theme           Json?            @db.JsonB
  features        Json?            @db.JsonB
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([projectId, characterId])
  @@map("developer_embed_configs")
}


