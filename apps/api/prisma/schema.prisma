// -----------------------------------------------------------------------------
// 8. AI Quality, Model Routing, Evaluation & Reliability Layer (Phase 8)
// -----------------------------------------------------------------------------

model AIModel {
  id               String              @id @default(uuid()) @db.Uuid
  provider         String              @db.VarChar(50) // 'mock', 'openai', 'anthropic', 'google', 'local'
  modelName        String              @map("model_name") @db.VarChar(100)
  displayName      String              @map("display_name") @db.VarChar(100)
  capabilities     Json                @db.JsonB // ['streaming', 'structured_output', 'tool_calling', etc.]
  contextWindow    Int                 @default(8192) @map("context_window")
  inputCostPer1k   Float               @default(0.0) @map("input_cost_per_1k")
  outputCostPer1k  Float               @default(0.0) @map("output_cost_per_1k")
  latencyClass     String              @default("balanced") @map("latency_class") @db.VarChar(20)
  qualityClass     String              @default("standard") @map("quality_class") @db.VarChar(20)
  isEnabled        Boolean             @default(true) @map("is_enabled")
  isDefault        Boolean             @default(false) @map("is_default")
  fallbackModelId  String?             @map("fallback_model_id") @db.Uuid
  fallbackModel    AIModel?            @relation("ModelFallback", fields: [fallbackModelId], references: [id], onDelete: SetNull)
  fallbackFor      AIModel[]           @relation("ModelFallback")
  routingPolicies  AIRoutingPolicy[]
  generationTraces AIGenerationTrace[]
  evaluationRuns   AIEvaluationRun[]
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([provider, modelName])
  @@index([isEnabled, isDefault])
  @@map("ai_models")
}

model AIRoutingPolicy {
  id                 String   @id @default(uuid()) @db.Uuid
  workload           String   @unique @db.VarChar(50) // 'CONVERSATION', 'MEMORY_EXTRACTION', etc.
  preferredModelId   String   @map("preferred_model_id") @db.Uuid
  preferredModel     AIModel  @relation(fields: [preferredModelId], references: [id], onDelete: Cascade)
  fallbackModelIds   String[] @map("fallback_model_ids")
  latencySensitivity String   @default("MEDIUM") @map("latency_sensitivity") @db.VarChar(20)
  maxCostPerRequest  Float?   @map("max_cost_per_request")
  isEnabled          Boolean  @default(true) @map("is_enabled")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([workload, isEnabled])
  @@map("ai_routing_policies")
}

model AIPrompt {
  id              String               @id @default(uuid()) @db.Uuid
  name            String               @db.VarChar(100)
  slug            String               @unique @db.VarChar(100)
  category        String               @db.VarChar(50) // 'CONVERSATION_SYSTEM', 'MEMORY_EXTRACTION', etc.
  description     String               @default("") @db.VarChar(500)
  activeVersionId String?              @map("active_version_id") @db.Uuid
  versions        AIPromptVersion[]
  experiments     AIPromptExperiment[]
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([category])
  @@map("ai_prompts")
}

model AIPromptVersion {
  id               String              @id @default(uuid()) @db.Uuid
  promptId         String              @map("prompt_id") @db.Uuid
  prompt           AIPrompt            @relation(fields: [promptId], references: [id], onDelete: Cascade)
  versionNumber    Int                 @map("version_number")
  status           String              @default("DRAFT") @db.VarChar(20) // 'DRAFT', 'TESTING', 'PUBLISHED', 'ARCHIVED'
  templateContent  String              @map("template_content") @db.Text
  inputVariables   String[]            @map("input_variables")
  tokenEstimate    Int                 @default(0) @map("token_estimate")
  hash             String              @db.VarChar(64)
  publishedAt      DateTime?           @map("published_at") @db.Timestamptz(6)
  generationTraces AIGenerationTrace[]
  evaluationRuns   AIEvaluationRun[]
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([promptId, versionNumber])
  @@index([promptId, status])
  @@map("ai_prompt_versions")
}

model AIPromptExperiment {
  id                String   @id @default(uuid()) @db.Uuid
  name              String   @db.VarChar(100)
  promptId          String   @map("prompt_id") @db.Uuid
  prompt            AIPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)
  controlVersionId  String   @map("control_version_id") @db.Uuid
  testVersionId     String   @map("test_version_id") @db.Uuid
  trafficSplitRatio Float    @default(0.5) @map("traffic_split_ratio")
  isActive          Boolean  @default(true) @map("is_active")
  metrics           Json?    @db.JsonB
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([promptId, isActive])
  @@map("ai_prompt_experiments")
}

model AIEvaluationDataset {
  id          String                 @id @default(uuid()) @db.Uuid
  name        String                 @db.VarChar(100)
  slug        String                 @unique @db.VarChar(100)
  category    String                 @default("general") @db.VarChar(50)
  description String                 @default("") @db.VarChar(500)
  version     Int                    @default(1)
  testCases   AIEvaluationTestCase[]
  runs        AIEvaluationRun[]
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("ai_evaluation_datasets")
}

model AIEvaluationTestCase {
  id                        String               @id @default(uuid()) @db.Uuid
  datasetId                 String               @map("dataset_id") @db.Uuid
  dataset                   AIEvaluationDataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  title                     String               @db.VarChar(200)
  category                  String               @default("dialogue") @db.VarChar(50)
  inputPrompt               String               @map("input_prompt") @db.Text
  userMessage               String               @map("user_message") @db.Text
  characterId               String?              @map("character_id") @db.Uuid
  character                 Character?           @relation(fields: [characterId], references: [id], onDelete: SetNull)
  characterConfigSnapshot   Json?                @map("character_config_snapshot") @db.JsonB
  memoryContextSnapshot     Json?                @map("memory_context_snapshot") @db.JsonB
  relationshipStateSnapshot Json?                @map("relationship_state_snapshot") @db.JsonB
  expectedProperties        Json                 @default("{}") @map("expected_properties") @db.JsonB
  tags                      String[]
  results                   AIEvaluationResult[]
  createdAt                 DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([datasetId, category])
  @@map("ai_evaluation_test_cases")
}

model AIEvaluationRun {
  id                 String               @id @default(uuid()) @db.Uuid
  datasetId          String               @map("dataset_id") @db.Uuid
  dataset            AIEvaluationDataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  datasetVersion     Int                  @default(1) @map("dataset_version")
  characterId        String?              @map("character_id") @db.Uuid
  character          Character?           @relation(fields: [characterId], references: [id], onDelete: SetNull)
  characterVersionId String?              @map("character_version_id") @db.Uuid
  characterVersion   CharacterVersion?    @relation(fields: [characterVersionId], references: [id], onDelete: SetNull)
  promptVersionId    String?              @map("prompt_version_id") @db.Uuid
  promptVersion      AIPromptVersion?     @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)
  modelId            String               @map("model_id") @db.Uuid
  model              AIModel              @relation(fields: [modelId], references: [id], onDelete: Cascade)
  provider           String               @db.VarChar(50)
  status             String               @default("RUNNING") @db.VarChar(20) // 'RUNNING', 'COMPLETED', 'FAILED', 'CANCELLED'
  totalCases         Int                  @default(0) @map("total_cases")
  passedCases        Int                  @default(0) @map("passed_cases")
  failedCases        Int                  @default(0) @map("failed_cases")
  averageLatencyMs   Float                @default(0) @map("average_latency_ms")
  totalCostUsd       Float                @default(0) @map("total_cost_usd")
  compositeScore     Float                @default(0) @map("composite_score")
  scoreBreakdown     Json                 @default("{}") @map("score_breakdown") @db.JsonB
  regressionStatus   String               @default("NO_REGRESSION") @map("regression_status") @db.VarChar(30)
  baselineRunId      String?              @map("baseline_run_id") @db.Uuid
  startedAt          DateTime             @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt        DateTime?            @map("completed_at") @db.Timestamptz(6)
  results            AIEvaluationResult[]
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([datasetId, status])
  @@index([modelId, status])
  @@index([startedAt(sort: Desc)])
  @@map("ai_evaluation_runs")
}

model AIEvaluationResult {
  id              String               @id @default(uuid()) @db.Uuid
  runId           String               @map("run_id") @db.Uuid
  run             AIEvaluationRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  testCaseId      String               @map("test_case_id") @db.Uuid
  testCase        AIEvaluationTestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  generatedOutput String               @map("generated_output") @db.Text
  latencyMs       Int                  @default(0) @map("latency_ms")
  tokensUsed      Int                  @default(0) @map("tokens_used")
  costUsd         Float                @default(0) @map("cost_usd")
  scores          Json                 @default("{}") @db.JsonB
  passed          Boolean              @default(true)
  reasoning       String?              @db.Text
  violations      String[]
  regressionDelta Float?               @map("regression_delta")
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([runId, passed])
  @@map("ai_evaluation_results")
}

model AIGenerationTrace {
  id                 String            @id @default(uuid()) @db.Uuid
  requestId          String            @map("request_id") @db.VarChar(100)
  userId             String?           @map("user_id") @db.Uuid
  user               User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  characterId        String?           @map("character_id") @db.Uuid
  character          Character?        @relation(fields: [characterId], references: [id], onDelete: SetNull)
  characterVersionId String?           @map("character_version_id") @db.Uuid
  characterVersion   CharacterVersion? @relation(fields: [characterVersionId], references: [id], onDelete: SetNull)
  conversationId     String?           @map("conversation_id") @db.Uuid
  promptVersionId    String?           @map("prompt_version_id") @db.Uuid
  promptVersion      AIPromptVersion?  @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)
  modelId            String?           @map("model_id") @db.Uuid
  model              AIModel?          @relation(fields: [modelId], references: [id], onDelete: SetNull)
  provider           String            @db.VarChar(50)
  workload           String            @db.VarChar(50)
  promptTokens       Int               @default(0) @map("prompt_tokens")
  completionTokens   Int               @default(0) @map("completion_tokens")
  totalTokens        Int               @default(0) @map("total_tokens")
  costUsd            Float             @default(0.0) @map("cost_usd")
  latencyMs          Int               @default(0) @map("latency_ms")
  timeToFirstTokenMs Int?              @map("time_to_first_token_ms")
  status             String            @default("SUCCESS") @db.VarChar(20) // 'SUCCESS', 'FAILED', 'CANCELLED', 'TIMEOUT'
  errorCode          String?           @map("error_code") @db.VarChar(50)
  contextHash        String?           @map("context_hash") @db.VarChar(64)
  isFallback         Boolean           @default(false) @map("is_fallback")
  metadata           Json?             @db.JsonB
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([requestId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([characterId, createdAt(sort: Desc)])
  @@index([workload, createdAt(sort: Desc)])
  @@index([status, errorCode])
  @@map("ai_generation_traces")
}

model AIProviderHealth {
  id               String    @id @default(uuid()) @db.Uuid
  provider         String    @unique @db.VarChar(50)
  status           String    @default("HEALTHY") @db.VarChar(20) // 'HEALTHY', 'DEGRADED', 'OUTAGE'
  successRate      Float     @default(1.0) @map("success_rate")
  averageLatencyMs Float     @default(0.0) @map("average_latency_ms")
  lastFailureAt    DateTime? @map("last_failure_at") @db.Timestamptz(6)
  circuitOpen      Boolean   @default(false) @map("circuit_open")
  circuitOpenUntil DateTime? @map("circuit_open_until") @db.Timestamptz(6)
  metadata         Json?     @db.JsonB
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("ai_provider_health")
}

