model AccountDeletionRequest {
  id                        String                @id @default(uuid()) @db.Uuid
  userId                    String                @map("user_id") @db.Uuid
  user                      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  status                    AccountDeletionStatus @default(PENDING)
  reason                    String?               @db.Text
  scheduledFor              DateTime              @map("scheduled_for") @db.Timestamptz(6)
  anonymizeFinancialRecords Boolean               @default(true) @map("anonymize_financial_records")
  completedAt               DateTime?             @map("completed_at") @db.Timestamptz(6)
  /// Resumable pipeline state: the step currently (or last) executed and every step already done.
  currentStep               String?               @map("current_step") @db.VarChar(40)
  completedSteps            String[]              @default([]) @map("completed_steps")
  attempts                  Int                   @default(0)
  lastError                 String?               @map("last_error") @db.VarChar(1000)
  /// Lease lock: a worker owns the request until `lockedUntil`; expired leases are reclaimed.
  lockedBy                  String?               @map("locked_by") @db.VarChar(100)
  lockedUntil               DateTime?             @map("locked_until") @db.Timestamptz(6)
  startedAt                 DateTime?             @map("started_at") @db.Timestamptz(6)
  verifiedAt                DateTime?             @map("verified_at") @db.Timestamptz(6)
  stepLog                   Json                  @default("[]") @map("step_log") @db.JsonB
  createdAt                 DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId, status])
  @@index([status, scheduledFor])
  @@index([status, lockedUntil])
  @@map("account_deletion_requests")
}

